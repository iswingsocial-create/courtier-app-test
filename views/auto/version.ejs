<%- include('../partials/haut', { titre: 'Soumission #' + s.id + ' — version ' + version.version }) %>
<div class="entete-page">
  <h1>🕘 Soumission #<%= s.id %> — version v<%= version.version %></h1>
  <div>
    <span class="badge badge-gris"><%= NOMS_STATUTS_SOUMISSION[version.statut] || version.statut %></span>
    <a class="btn btn-secondaire btn-petit" href="/auto/<%= s.id %>#versions">← Fiche soumission</a>
  </div>
</div>

<p class="petit">Instantané figé du <%= (version.cree_le || '').slice(0, 16).replace('T', ' ') %> par <%= version.auteur || '—' %> — lecture seule, rien ne peut être modifié ici.</p>

<div class="carte">
  <dl class="dl">
    <dt>Entreprise</dt><dd><strong><%= clientNom %></strong></dd>
    <dt>Date d’effet souhaitée</dt><dd><%= version.date_effet_souhaitee || '—' %></dd>
    <dt>Notes</dt><dd><%= version.notes || '—' %></dd>
  </dl>
</div>

<% const d = version.donnees || {}; %>
<div class="carte">
  <h2>👤 Conducteurs (<%= (d.conducteurs || []).length %>)</h2>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Nom</th><th>Naissance</th><th>Permis</th><th>Principal</th></tr></thead>
    <tbody>
    <% (d.conducteurs || []).forEach((c) => { %>
      <tr><td><%= c.prenom %> <%= c.nom %></td><td><%= c.date_naissance || '—' %></td>
        <td><%= c.numero_permis ? c.numero_permis + ' (' + (c.province_permis || 'QC') + ')' : '—' %></td>
        <td><%= c.conducteur_principal ? 'Oui' : '—' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (!(d.conducteurs || []).length) { %><p class="petit">Aucun.</p><% } %>
</div>

<div class="carte">
  <h2>🚙 Véhicules (<%= (d.vehicules || []).length %>)</h2>
  <% (d.vehicules || []).forEach((v) => { %>
    <h3><%= [v.annee, v.marque, v.modele].filter(Boolean).join(' ') || 'Véhicule' %></h3>
    <dl class="dl">
      <dt>NIV</dt><dd><%= v.vin || '—' %></dd>
      <dt>Usage</dt><dd><%= v.usage || '—' %></dd>
      <dt>Financement</dt><dd><%= v.financement || '—' %></dd>
      <dt>Garanties</dt><dd>
        <% if (v.garanties) { %>
          RC <%= v.garanties.rc_montant ? Number(v.garanties.rc_montant).toLocaleString('fr-CA') + ' $' : '—' %> ·
          <%= v.garanties.protection_b ? NOMS_PROTECTION_B[v.garanties.protection_b] : '—' %> ·
          franchise <%= v.garanties.franchise_b ? Number(v.garanties.franchise_b).toLocaleString('fr-CA') + ' $' : '—' %>
          <% const av = v.garanties.avenants || {}; const codes = Object.keys(av).filter((k) => av[k]); %>
          <% if (codes.length) { %><br><span class="petit">Avenants : <%= codes.map((k) => (AVENANTS_FAQ.find(([c]) => c === k) || [k, k])[1]).join(', ') %></span><% } %>
        <% } else { %>—<% } %>
      </dd>
    </dl>
  <% }) %>
  <% if (!(d.vehicules || []).length) { %><p class="petit">Aucun.</p><% } %>
</div>

<div class="carte">
  <h2>📋 Antécédents</h2>
  <% const a = d.antecedents; %>
  <% if (a) { %>
  <dl class="dl">
    <dt>Assureur actuel</dt><dd><%= a.assureur_actuel || '—' %></dd>
    <dt>Police actuelle</dt><dd><%= a.numero_police_actuelle || '—' %></dd>
    <dt>Résiliation / non-paiement / faillite / casier</dt>
    <dd><%= [a.resiliation_ant && 'résiliation', a.non_paiement_ant && 'non-paiement', a.faillite && 'faillite', a.casier_judiciaire && 'casier'].filter(Boolean).join(', ') || 'Aucun' %></dd>
    <dt>Sinistres 6 ans</dt><dd><%= (a.sinistres_6ans || []).length ? a.sinistres_6ans.map((x) => [x.date, x.type, x.montant ? x.montant + ' $' : null].filter(Boolean).join(' — ')).join(' ; ') : 'Aucun' %></dd>
  </dl>
  <% } else { %><p class="petit">Non renseignés.</p><% } %>
</div>
<%- include('../partials/bas') %>
