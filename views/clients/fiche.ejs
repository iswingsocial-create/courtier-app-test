<%- include('../partials/haut', { titre: client.raison_sociale }) %>
<div class="entete-page">
  <h1>🏢 <%= client.raison_sociale %></h1>
  <div class="actions" style="margin-top:0">
    <a class="btn btn-secondaire btn-petit" href="/clients/<%= client.id %>/modifier">Modifier</a>
    <a class="btn btn-secondaire btn-petit" href="/polices/nouvelle?client=<%= client.id %>">+ Police</a>
    <a class="btn btn-secondaire btn-petit" href="/reclamations/nouvelle?client=<%= client.id %>">+ Réclamation</a>
    <a class="btn btn-secondaire btn-petit" href="/taches/nouvelle?entreprise=<%= client.id %>">+ Tâche</a>
    <a class="btn btn-secondaire btn-petit" href="/clients">← Entreprises</a>
  </div>
</div>

<% if (mAJout) { %><div class="alerte alerte-succes">Document téléversé.</div><% } %>

<div class="carte">
  <dl class="dl">
    <dt>NEQ</dt><dd><%= client.neq || '—' %></dd>
    <dt>Secteur d’activité</dt><dd><%= client.secteur_activite || '—' %></dd>
    <dt>Courriel de l’entreprise</dt><dd><%= client.courriel_entreprise || '—' %></dd>
    <dt>Téléphone de l’entreprise</dt><dd><%= client.telephone_entreprise || '—' %></dd>
    <dt>Chiffre d’affaires</dt><dd><%= client.chiffre_affaires != null ? Number(client.chiffre_affaires).toLocaleString('fr-CA') + ' $' : '—' %></dd>
    <dt>Nombre d’employés</dt><dd><%= client.nb_employes != null ? client.nb_employes : '—' %></dd>
    <dt>Adresse</dt><dd><%= [client.adresse, client.ville, client.code_postal].filter(Boolean).join(', ') || '—' %></dd>
    <dt>Langue</dt><dd><%= client.langue === 'EN' ? 'Anglais' : 'Français' %></dd>
    <dt>Courtier responsable</dt><dd><%= client.responsable_nom || '—' %></dd>
    <% if (client.notes) { %><dt>Notes</dt><dd><%= client.notes %></dd><% } %>
  </dl>
  <h3>Consentements — Loi 25</h3>
  <ul>
  <% TYPES_CONSENTEMENT.forEach((t) => { const c = consentements[t.type]; %>
    <li><%= c && c.accepte ? '✅' : '❌' %> <%= t.libelle %>
      <% if (c && c.accepte && c.date_consentement) { %><span class="petit">(le <%= c.date_consentement %>)</span><% } %></li>
  <% }) %>
  </ul>
</div>

<div class="carte" id="contacts">
  <h3>👥 Contacts (<%= contacts.length %>)</h3>
  <% contacts.forEach((ct) => { %>
    <div class="ligne-contact">
      <strong><%= ct.prenom %> <%= ct.nom %></strong>
      <% if (ct.principal) { %><span class="badge">Principal</span><% } %>
      <%= ct.titre ? ' — ' + ct.titre : '' %><br>
      <span class="petit"><%= ct.courriel || '' %><%= ct.courriel && ct.telephone ? ' · ' : '' %><%= ct.telephone || '' %></span>
      <div class="actions-ligne">
        <details class="details-inline">
          <summary class="btn btn-secondaire btn-petit">Modifier</summary>
          <form method="post" action="/clients/contacts/<%= ct.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="grille-form">
              <div><label>Prénom *</label><input type="text" name="prenom" required value="<%= ct.prenom %>"></div>
              <div><label>Nom *</label><input type="text" name="nom" required value="<%= ct.nom %>"></div>
              <div><label>Titre / fonction</label><input type="text" name="titre" value="<%= ct.titre || '' %>"></div>
              <div><label>Courriel</label><input type="email" name="courriel" value="<%= ct.courriel || '' %>"></div>
              <div><label>Téléphone</label><input type="tel" name="telephone" value="<%= ct.telephone || '' %>"></div>
            </div>
            <button class="btn btn-petit" type="submit">Enregistrer</button>
          </form>
        </details>
        <% if (!ct.principal) { %>
          <form method="post" action="/clients/contacts/<%= ct.id %>/principal" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-secondaire btn-petit" type="submit">Définir principal</button>
          </form>
          <form method="post" action="/clients/contacts/<%= ct.id %>/archiver" style="display:inline" data-confirm="Archiver ce contact ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-secondaire btn-petit" type="submit">Archiver</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
  <% if (!contacts.length) { %><p class="petit">Aucun contact pour l’instant.</p><% } %>

  <details>
    <summary class="btn btn-petit">+ Ajouter un contact</summary>
    <form method="post" action="/clients/<%= client.id %>/contacts">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grille-form">
        <div><label>Prénom *</label><input type="text" name="prenom" required></div>
        <div><label>Nom *</label><input type="text" name="nom" required></div>
        <div><label>Titre / fonction</label><input type="text" name="titre" placeholder="ex. : contrôleur"></div>
        <div><label>Courriel</label><input type="email" name="courriel"></div>
        <div><label>Téléphone</label><input type="tel" name="telephone"></div>
      </div>
      <button class="btn btn-petit" type="submit">Ajouter</button>
    </form>
  </details>
  <% if (contactsArchives.length) { %>
    <details>
      <summary class="petit">Contacts archivés (<%= contactsArchives.length %>)</summary>
      <ul>
      <% contactsArchives.forEach((ct) => { %>
        <li><%= ct.prenom %> <%= ct.nom %>
          <form method="post" action="/clients/contacts/<%= ct.id %>/desarchiver" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-secondaire btn-petit" type="submit">Désarchiver</button>
          </form>
        </li>
      <% }) %>
      </ul>
    </details>
  <% } %>
</div>

<div class="carte">
  <h3>📄 Polices par assureur (<%= polices.length %>)</h3>
  <% if (!polices.length) { %><p class="petit">Aucune police. <a href="/polices/nouvelle?client=<%= client.id %>">Créez-en une</a>.</p><% } else { %>
  <% policesParAssureur.forEach((g) => { %>
    <h4>🏦 <%= g.nom %></h4>
    <p class="petit">
      📝 Nouvelle affaire : <%= g.na.nom || '—' %><%= g.na.telephone ? ' · ' + g.na.telephone : '' %><%= g.na.courriel ? ' · ' + g.na.courriel : '' %><br>
      🔧 Modifications : <%= g.mod.nom || '—' %><%= g.mod.telephone ? ' · ' + g.mod.telephone : '' %><%= g.mod.courriel ? ' · ' + g.mod.courriel : '' %>
    </p>
    <div class="tableau-deroulant"><table>
      <thead><tr><th>Numéro</th><th>Produit</th><th>Échéance</th><th>Prime</th><th>Statut</th><th></th></tr></thead>
      <tbody><% g.polices.forEach((p) => { %>
        <tr><td><%= p.numero_police %></td><td><%= p.ligne %></td>
        <td><%= p.date_echeance %></td><td><%= Number(p.prime_totale).toFixed(2) %> $</td><td><%= p.statut %></td>
        <td><a class="btn btn-petit btn-secondaire" href="/echeances/police/<%= p.id %>">Réviser</a></td></tr>
      <% }) %></tbody>
    </table></div>
  <% }) %><% } %>
</div>

<div class="carte">
  <h3>🧾 Réclamations (<%= reclamations.length %>)</h3>
  <% if (!reclamations.length) { %><p class="petit">Aucune réclamation.</p><% } else { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Sinistre</th><th>Police</th><th>Statut</th><th>Montant réclamé</th><th></th></tr></thead>
    <tbody><% reclamations.forEach((r) => { %>
      <tr><td><%= r.date_sinistre %></td><td><%= r.numero_police || '—' %></td>
      <td><span class="badge badge-gris"><%= NOMS_RECLAMATION[r.statut] %></span></td>
      <td><%= r.montant_reclame != null ? Number(r.montant_reclame).toFixed(2) + ' $' : '—' %></td>
      <td><a class="btn btn-petit btn-secondaire" href="/reclamations/<%= r.id %>">Ouvrir</a></td></tr>
    <% }) %></tbody>
  </table></div><% } %>
</div>

<div class="carte">
  <h3>📌 Tâches en cours (<%= taches.length %>)</h3>
  <% if (!taches.length) { %><p class="petit">Aucune tâche en cours.</p><% } else { %>
  <ul><% taches.forEach((t) => { %>
    <li><strong><%= t.titre %></strong>
      <span class="petit">(<%= t.date_echeance || 'sans échéance' %><%= t.assigne_nom ? ' · ' + t.assigne_nom : '' %>)</span></li>
  <% }) %></ul><% } %>
</div>

<div class="carte">
  <h3>📎 Documents</h3>
  <form method="post" action="/clients/<%= client.id %>/documents" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="doc">Ajouter un document (PDF, image, Word, Excel — max 10 Mo)</label>
    <input type="file" id="doc" name="document" required>
    <div class="actions"><button class="btn btn-petit" type="submit">Téléverser</button></div>
  </form>
  <% if (documents.length) { %>
  <ul><% documents.forEach((d) => { %>
    <li><a href="/clients/documents/<%= d.id %>"><%= d.nom_origine %></a>
      <span class="petit">(<%= Math.round(d.taille / 1024) %> Ko)</span>
      <form method="post" action="/clients/documents/<%= d.id %>/archiver" class="inline" data-confirm="Archiver ce document ?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="lien" type="submit">archiver</button>
      </form></li>
  <% }) %></ul>
  <% } %>
  <% if (documentsArchives.length) { %>
  <h4 class="petit">Documents archivés</h4>
  <ul><% documentsArchives.forEach((d) => { %>
    <li><span class="petit"><%= d.nom_origine %></span>
      <form method="post" action="/clients/documents/<%= d.id %>/desarchiver" class="inline" data-confirm="Désarchiver ce document ?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="lien" type="submit">désarchiver</button>
      </form></li>
  <% }) %></ul>
  <% } %>
</div>

<div class="carte">
  <h3>Archiver</h3>
  <p class="petit">Archiver cette entreprise la retire des listes actives sans effacer son historique (polices, réclamations, documents). Vous pouvez la désarchiver en tout temps.</p>
  <form method="post" action="/clients/<%= client.id %>/<%= client.archive ? 'desarchiver' : 'archiver' %>" data-confirm="<%= client.archive ? 'Désarchiver cette entreprise ?' : 'Archiver cette entreprise ?' %>">    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-secondaire btn-petit" type="submit"><%= client.archive ? 'Désarchiver l’entreprise' : 'Archiver l’entreprise' %></button>
  </form>
</div>
<%- include('../partials/bas') %>
