<%- include('../partials/haut', { titre: client && client.id ? 'Modifier l’entreprise' : 'Nouvelle entreprise' }) %>
<div class="entete-page">
  <h1><%= client && client.id ? '✏️ Modifier l’entreprise' : '➕ Nouvelle entreprise' %></h1>
  <a class="btn btn-secondaire btn-petit" href="<%= client && client.id ? '/clients/' + client.id : '/clients' %>">← Retour</a>
</div>

<% if (erreur) { %><div class="alerte alerte-erreur"><%= erreur %></div><% } %>

<div class="carte">
<form method="post" action="<%= client && client.id ? '/clients/' + client.id : '/clients' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" id="place_id_google" name="place_id_google" value="<%= client && client.place_id_google ? client.place_id_google : '' %>">
  <% if (typeof googleConfiguree !== 'undefined' && googleConfiguree) { %>
  <div style="border:1px solid #ccc;border-radius:8px;padding:12px;margin-bottom:14px;">
    <h3 style="margin-top:0;">🗺️ Rechercher sur Google Maps</h3>
    <p class="petit">Retrouvez l’entreprise pour remplir adresse, ville, province, code postal,
      téléphone et site web d’un clic. Vérifiez avant d’enregistrer — rien n’est écrit sans vous.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <input type="text" id="rech-google-q" placeholder="Nom de l’entreprise, ville…" style="flex:1;min-width:220px;" value="<%= client ? (client.raison_sociale || '') : '' %>">
      <button type="button" id="btn-rech-google" class="btn btn-secondaire">🔍 Rechercher sur Google Maps</button>
    </div>
    <div id="resultats-google" style="margin-top:10px;"></div>
  </div>
  <% } %>
  <h3>Entreprise</h3>
  <div class="grille-form">
    <div><label for="raison_sociale">Raison sociale *</label><input type="text" id="raison_sociale" name="raison_sociale" required value="<%= client ? (client.raison_sociale || '') : '' %>"></div>
    <div><label for="neq">NEQ (10 chiffres)</label><input type="text" id="neq" name="neq" maxlength="10" value="<%= client && client.neq ? client.neq : '' %>"></div>
    <div><label for="secteur_activite">Secteur d’activité</label><input type="text" id="secteur_activite" name="secteur_activite" value="<%= client && client.secteur_activite ? client.secteur_activite : '' %>"></div>
    <div><label for="courriel_entreprise">Courriel de l’entreprise</label><input type="email" id="courriel_entreprise" name="courriel_entreprise" value="<%= client && client.courriel_entreprise ? client.courriel_entreprise : '' %>"></div>
    <div><label for="telephone_entreprise">Téléphone de l’entreprise</label><input type="tel" id="telephone_entreprise" name="telephone_entreprise" value="<%= client && client.telephone_entreprise ? client.telephone_entreprise : '' %>"></div>
    <div><label for="site_web">Site web</label><input type="text" id="site_web" name="site_web" value="<%= client && client.site_web ? client.site_web : '' %>"></div>
    <div><label for="chiffre_affaires">Chiffre d’affaires ($)</label><input type="number" id="chiffre_affaires" name="chiffre_affaires" min="0" step="0.01" value="<%= client && client.chiffre_affaires != null ? client.chiffre_affaires : '' %>"></div>
    <div><label for="nb_employes">Nombre d’employés</label><input type="number" id="nb_employes" name="nb_employes" min="0" step="1" value="<%= client && client.nb_employes != null ? client.nb_employes : '' %>"></div>
    <% if (peutChangerResponsable) { %>
    <div><label for="responsable_id">Courtier responsable</label>
      <select id="responsable_id" name="responsable_id">
        <option value="">— Aucun —</option>
        <% utilisateurs.forEach((u) => { %>
          <option value="<%= u.id %>" <%= client && String(client.responsable_id) === String(u.id) ? 'selected' : '' %>><%= u.nom %> (<%= u.role %>)</option>
        <% }) %>
      </select></div>
    <% } else if (client && client.id) { %>
    <div><label>Courtier responsable</label><p class="petit">Seul l’administrateur peut changer le courtier responsable.</p></div>
    <% } %>
  </div>

  <%
    // Profil de souscription (soumission combinée) : listes et répartitions.
    const FORMES_JURIDIQUES_VUE = [['societe_actions', 'Société par actions'], ['proprietaire_unique', 'Propriétaire unique'], ['srl', 'Société à responsabilité limitée'], ['fiducie', 'Fiducie'], ['snc', 'Société en nom collectif'], ['coentreprise', 'Coentreprise'], ['association', 'Association'], ['autre', 'Autre']];
    const REP_GEO = [['canada', 'Canada'], ['etats_unis', 'États-Unis'], ['etranger', 'Étranger'], ['internet', 'Internet']];
    const REP_TYPES = [['detail', 'Détail'], ['gros', 'Gros'], ['reparation', 'Réparation'], ['fabrication', 'Fabrication'], ['estimation', 'Estimation'], ['affinage', 'Affinage'], ['achat_or', 'Achat d\u2019or'], ['autre', 'Autre']];
    function repValeur(source, prefixe, cle) {
      if (!source) return '';
      const brut = source[prefixe + cle];
      if (brut !== undefined && brut !== null && brut !== '') return brut;
      return '';
    }
    function repValeurJson(json, prefixe, cle) {
      if (!json) return '';
      try { const o = JSON.parse(json); return o && o[cle] != null ? o[cle] : ''; } catch (e) { return ''; }
    }
  %>
  <h3>Profil de souscription — soumission combinée</h3>
  <p class="petit">Ces renseignements alimentent les « Renseignements généraux » et la tarification RC des soumissions combinées (Biens + RC + Perte d’exploitation). Tous facultatifs.</p>
  <div class="grille-form">
    <div><label for="forme_juridique">Forme juridique</label>
      <select id="forme_juridique" name="forme_juridique">
        <option value="">— Non précisée —</option>
        <% FORMES_JURIDIQUES_VUE.forEach(([code, lib]) => { %>
          <option value="<%= code %>" <%= client && client.forme_juridique === code ? 'selected' : '' %>><%= lib %></option>
        <% }) %>
      </select></div>
    <div><label for="annee_fondation">Année de fondation (en affaire depuis)</label><input type="number" id="annee_fondation" name="annee_fondation" min="1800" max="2100" step="1" value="<%= client && client.annee_fondation != null ? client.annee_fondation : '' %>"></div>
    <div><label for="annees_experience_liee">Expérience antérieure liée (années)</label><input type="number" id="annees_experience_liee" name="annees_experience_liee" min="0" step="1" value="<%= client && client.annees_experience_liee != null ? client.annees_experience_liee : '' %>"></div>
    <div><label for="noms_exploitation">Noms d’exploitation et filiales à assurer</label><input type="text" id="noms_exploitation" name="noms_exploitation" value="<%= client && client.noms_exploitation ? client.noms_exploitation : '' %>"></div>
    <div><label for="code_industrie">Code de l’industrie</label><input type="text" id="code_industrie" name="code_industrie" value="<%= client && client.code_industrie ? client.code_industrie : '' %>"></div>
    <div><label for="code_industrie_description">Description du code de l’industrie</label><input type="text" id="code_industrie_description" name="code_industrie_description" value="<%= client && client.code_industrie_description ? client.code_industrie_description : '' %>"></div>
    <div><label for="code_industrie_pct_revenus">% des revenus (code de l’industrie)</label><input type="number" id="code_industrie_pct_revenus" name="code_industrie_pct_revenus" min="0" max="100" step="0.01" value="<%= client && client.code_industrie_pct_revenus != null ? client.code_industrie_pct_revenus : '' %>"></div>
    <div><label for="masse_salariale">Masse salariale annuelle ($)</label><input type="number" id="masse_salariale" name="masse_salariale" min="0" step="0.01" value="<%= client && client.masse_salariale != null ? client.masse_salariale : '' %>"></div>
    <div><label for="nb_employes_temps_plein">Employés à temps plein</label><input type="number" id="nb_employes_temps_plein" name="nb_employes_temps_plein" min="0" step="1" value="<%= client && client.nb_employes_temps_plein != null ? client.nb_employes_temps_plein : '' %>"></div>
    <div><label for="nb_employes_temps_partiel">Employés à temps partiel</label><input type="number" id="nb_employes_temps_partiel" name="nb_employes_temps_partiel" min="0" step="1" value="<%= client && client.nb_employes_temps_partiel != null ? client.nb_employes_temps_partiel : '' %>"></div>
    <div><label for="pct_sous_traitance">Sous-traitance (% des recettes)</label><input type="number" id="pct_sous_traitance" name="pct_sous_traitance" min="0" max="100" step="0.01" value="<%= client && client.pct_sous_traitance != null ? client.pct_sous_traitance : '' %>"></div>
    <div class="case"><input type="checkbox" id="employes_csst" name="employes_csst" <%= client && client.employes_csst ? 'checked' : '' %>><label for="employes_csst">Employés couverts par la CSST</label></div>
    <div class="case"><input type="checkbox" id="responsabilite_alcool" name="responsabilite_alcool" <%= client && client.responsabilite_alcool ? 'checked' : '' %>><label for="responsabilite_alcool">Responsabilité liée à la vente de boissons alcoolisées</label></div>
  </div>
  <label for="description_activites">Description des activités de l’assuré</label>
  <textarea id="description_activites" name="description_activites"><%= client && client.description_activites ? client.description_activites : '' %></textarea>
  <div class="grille-form">
    <fieldset><legend>Répartition géographique des recettes (%)</legend>
      <% REP_GEO.forEach(([cle, lib]) => { const val = repValeur(client, 'rep_geo_', cle) !== '' ? repValeur(client, 'rep_geo_', cle) : repValeurJson(client && client.repartition_revenus_geo, 'rep_geo_', cle); %>
      <div><label for="rep_geo_<%= cle %>"><%= lib %></label><input type="number" id="rep_geo_<%= cle %>" name="rep_geo_<%= cle %>" min="0" max="100" step="0.01" value="<%= val %>"></div>
      <% }) %>
    </fieldset>
    <fieldset><legend>Répartition des recettes par type d’activité (%)</legend>
      <% REP_TYPES.forEach(([cle, lib]) => { const val = repValeur(client, 'rep_type_', cle) !== '' ? repValeur(client, 'rep_type_', cle) : repValeurJson(client && client.repartition_revenus_types, 'rep_type_', cle); %>
      <div><label for="rep_type_<%= cle %>"><%= lib %></label><input type="number" id="rep_type_<%= cle %>" name="rep_type_<%= cle %>" min="0" max="100" step="0.01" value="<%= val %>"></div>
      <% }) %>
    </fieldset>
  </div>

  <h3>Contact principal</h3>
  <p class="petit">Les autres contacts se gèrent dans la fiche de l’entreprise, section « Contacts ».</p>
  <div class="grille-form">
    <div><label for="prenom">Prénom *</label><input type="text" id="prenom" name="prenom" required value="<%= client ? client.prenom : '' %>"></div>
    <div><label for="nom">Nom *</label><input type="text" id="nom" name="nom" required value="<%= client ? client.nom : '' %>"></div>
    <div><label for="titre_contact">Titre / fonction</label><input type="text" id="titre_contact" name="titre_contact" placeholder="ex. : président, contrôleur" value="<%= client && client.titre_contact ? client.titre_contact : '' %>"></div>
    <div><label for="courriel">Courriel du contact</label><input type="email" id="courriel" name="courriel" value="<%= client && client.courriel ? client.courriel : '' %>"></div>
    <div><label for="telephone">Téléphone du contact</label><input type="tel" id="telephone" name="telephone" value="<%= client && client.telephone ? client.telephone : '' %>"></div>
    <div><label for="adresse">Adresse</label><input type="text" id="adresse" name="adresse" value="<%= client && client.adresse ? client.adresse : '' %>"></div>
    <div><label for="ville">Ville</label><input type="text" id="ville" name="ville" value="<%= client && client.ville ? client.ville : '' %>"></div>
    <div><label for="province">Province</label><input type="text" id="province" name="province" value="<%= client && client.province ? client.province : '' %>" placeholder="QC"></div>
    <div><label for="code_postal">Code postal</label><input type="text" id="code_postal" name="code_postal" value="<%= client && client.code_postal ? client.code_postal : '' %>"></div>
    <div><label for="langue">Langue</label>
      <select id="langue" name="langue">
        <option value="FR" <%= client && client.langue === 'FR' ? 'selected' : '' %>>Français</option>
        <option value="EN" <%= client && client.langue === 'EN' ? 'selected' : '' %>>Anglais</option>
      </select></div>
  </div>
  <label for="notes">Notes</label>
  <textarea id="notes" name="notes"><%= client && client.notes ? client.notes : '' %></textarea>

  <h3>Consentements — Loi 25</h3>
  <% TYPES_CONSENTEMENT.forEach((t) => { %>
    <div class="case">
      <input type="checkbox" id="c_<%= t.type %>" name="consent_<%= t.type %>" <%= consentements[t.type] && consentements[t.type].accepte ? 'checked' : '' %>>
      <label for="c_<%= t.type %>"><%= t.libelle %>
        <% if (consentements[t.type] && consentements[t.type].accepte) { %><span class="petit">(accepté le <%= consentements[t.type].date_consentement %>)</span><% } %>
      </label>
    </div>
  <% }) %>

  <div class="actions"><button class="btn" type="submit">Enregistrer</button></div>
</form>
</div>
<script src="/clients-google.js" defer></script>
<%- include('../partials/bas') %>
