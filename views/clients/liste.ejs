<%- include('../partials/haut', { titre: 'Entreprises' }) %>
<div class="entete-page">
  <h1>🏢 Entreprises</h1>
  <div>
    <% if (voirArchives) { %><a class="btn btn-secondaire btn-petit" href="/clients">← Actifs</a><% } else { %><a class="btn btn-secondaire btn-petit" href="/clients?archives=1">Voir les archivés</a><% } %>
    <a class="btn btn-petit" href="/clients/nouveau">+ Nouvelle entreprise</a>
  </div>
</div>

<div class="carte">
  <form method="get" action="/clients" class="grille-form">
    <% if (voirArchives) { %><input type="hidden" name="archives" value="1"><% } %>
    <div><input type="text" name="q" placeholder="Rechercher (raison sociale, NEQ, contact, secteur)…" value="<%= q %>"></div>
    <div class="actions" style="margin-top:0"><button class="btn btn-secondaire btn-petit" type="submit">Chercher</button>
    <% if (q) { %><a class="btn btn-secondaire btn-petit" href="/clients">Effacer</a><% } %></div>
  </form>
</div>

<div class="carte"><div class="tableau-deroulant"><table>
  <thead><tr><th>Raison sociale</th><th>NEQ</th><th>Contact</th><th>Téléphone</th><th>Ville</th><th>Responsable</th><th></th></tr></thead>
  <tbody>
  <% clients.forEach((c) => { %>
    <tr>
      <td><a href="/clients/<%= c.id %>"><strong><%= c.raison_sociale %></strong></a><br><span class="petit"><%= c.secteur_activite || '' %></span></td>
      <td><%= c.neq || '—' %></td>
      <td><%= c.prenom %> <%= c.nom %><%- c.titre_contact ? '<br><span class="petit">' + c.titre_contact + '</span>' : '' %></td>
      <td><%= c.telephone || '—' %></td>
      <td><%= c.ville || '—' %></td>
      <td><%= c.responsable_nom || '—' %></td>
      <td><a class="btn btn-petit btn-secondaire" href="/clients/<%= c.id %>">Ouvrir</a></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% if (!clients.length) { %><p class="petit">Aucune entreprise. <a href="/clients/nouveau">Créez la première</a> ou utilisez l’<a href="/import">import CSV</a>.</p><% } %>
</div>
<%- include('../partials/bas') %>
