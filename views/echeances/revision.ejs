      <td><% const g = e.garanties || {};
        %><%= g.formule ? (rcDonnees.NOMS_FORMULE_RC[g.formule] || g.formule) : '—' %><%= g.limite_par_sinistre != null ? ' · ' + Number(g.limite_par_sinistre).toLocaleString('fr-CA') + ' $/sin.' : '' %><%= g.limite_agregat != null ? ' · agr. ' + Number(g.limite_agregat).toLocaleString('fr-CA') + ' $' : '' %><%= g.franchise != null ? ' · fr. ' + Number(g.franchise).toLocaleString('fr-CA') + ' $' : '' %><% const avr = g.avenants || {}; const codesr = Object.keys(avr);
        %><%= codesr.length ? ' · ' + codesr.map((c) => { const f = rcDonnees.AVENANTS_RC.find(([code]) => code === c); return f ? f[1] : c; }).join(', ') : '' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %><p class="petit">Aucun lieu d’exploitation au snapshot de conversion.</p><% } %>
  <% const antrc = efig.antecedents || null; %>
