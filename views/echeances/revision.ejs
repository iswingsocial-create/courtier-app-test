    <dt>Sinistres (5 ans)</dt><dd><% const sinr = antrc.sinistres_5ans || []; %><%= sinr.length ? sinr.map((x) => [x.date, x.type, x.montant != null ? Number(x.montant).toLocaleString('fr-CA') + ' $' : null].filter(Boolean).join(' — ')).join(' ; ') : 'Aucun' %></dd>
  </dl>
  <% } %>
</div>
<% } %>

