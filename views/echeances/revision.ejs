<%- include('../partials/haut', { titre: 'Fiche de révision — ' + police.numero_police }) %>
<div class="entete-page">
  <h1>📋 Fiche de révision</h1>
  <div class="actions" style="margin-top:0">
    <a class="btn btn-petit" href="/polices/<%= police.id %>/modifier">✏️ Nouvelle version (avenant)</a>
    <a class="btn btn-secondaire btn-petit" href="/echeances">← Échéances</a>
  </div>
</div>

<div class="carte">
  <h3><%= police.client_raison_sociale %> — police <%= police.numero_police %></h3>
  <dl class="dl">
    <dt>Entreprise</dt><dd><a href="/clients/<%= police.client_id %>"><%= police.client_raison_sociale %></a>
      (<%= police.client_prenom %> <%= police.client_nom %><%= police.client_courriel ? ' · ' + police.client_courriel : '' %><%= police.client_telephone ? ' · ' + police.client_telephone : '' %>)</dd>
    <dt>Produit</dt><dd><%= NOMS_LIGNES[police.ligne] %></dd>
    <dt>Assureur</dt><dd><%= police.assureur %></dd>
    <dt>Effet / Échéance</dt><dd><%= police.date_effet %> → <strong><%= police.date_echeance %></strong>
      (<%= jours < 0 ? 'échue depuis ' + (-jours) + ' j' : 'dans ' + jours + ' j' %>)</dd>
    <dt>Statut</dt><dd><span class="badge badge-gris"><%= NOMS_STATUTS[police.statut] %></span></dd>
    <dt>Franchise</dt><dd><%= Number(police.franchise).toFixed(2) %> $</dd>
    <dt>Courtier responsable</dt><dd><%= police.responsable_nom || '—' %></dd>
    <% if (police.notes) { %><dt>Notes</dt><dd><%= police.notes %></dd><% } %>
  </dl>
</div>

<% if (fpq1Donnees) { %>
<div class="carte">
  <h3>🚗 Données FPQ1</h3>
  <p class="petit">Figées à la conversion (soumission auto
    <a href="/auto/<%= police.auto_soumission_id %>">#<%= police.auto_soumission_id %></a>,
    version <%= police.auto_soumission_version ? 'v' + police.auto_soumission_version : '—' %>
    <% if (police.auto_soumission_version) { %>(<a href="/auto/<%= police.auto_soumission_id %>/versions/<%= police.auto_soumission_version %>">voir le snapshot</a>)<% } %>).
    Les avenants en cours de terme se font sur la soumission et créent automatiquement une nouvelle version de cette police.</p>
  <% const fig = (fpq1Donnees.versionFige && fpq1Donnees.versionFige.donnees) || { conducteurs: [], vehicules: [] }; %>
  <h4>Conducteurs (<%= fig.conducteurs.length %>)</h4>
  <% if (fig.conducteurs.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Nom</th><th>Permis</th><th>Principal</th></tr></thead>
    <tbody><% fig.conducteurs.forEach((c) => { %>
      <tr><td><%= c.prenom %> <%= c.nom %></td><td><%= c.numero_permis || '—' %> (<%= c.province_permis || 'QC' %>)</td>
      <td><%= c.conducteur_principal ? 'Oui' : '—' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %><p class="petit">Aucun conducteur au snapshot de conversion.</p><% } %>
  <h4>Véhicules (<%= fig.vehicules.length %>)</h4>
  <% if (fig.vehicules.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Véhicule</th><th>VIN</th><th>RC</th><th>Protection B</th><th>Franchise</th><th>Avenants</th></tr></thead>
    <tbody><% fig.vehicules.forEach((v) => { %>
      <tr><td><%= v.annee || '' %> <%= v.marque || '' %> <%= v.modele || '' %></td>
      <td><%= v.vin || '—' %></td>
      <td><%= v.garanties && v.garanties.rc_montant ? Number(v.garanties.rc_montant).toLocaleString('fr-CA') + ' $' : '—' %></td>
      <td><%= v.garanties && v.garanties.protection_b ? (fpq1Donnees.NOMS_PROTECTION_B[v.garanties.protection_b] || v.garanties.protection_b) : '—' %></td>
      <td><%= v.garanties && v.garanties.franchise_b != null ? Number(v.garanties.franchise_b).toFixed(2) + ' $' : '—' %></td>
      <td><% const av = (v.garanties && v.garanties.avenants) || {}; const codes = Object.keys(av);
        %><%= codes.length ? codes.map((c) => { const f = fpq1Donnees.AVENANTS_FAQ.find(([code]) => code === c); return f ? f[1].split(' — ')[0] : c; }).join(', ') : '—' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %><p class="petit">Aucun véhicule au snapshot de conversion.</p><% } %>
  <% const live = fpq1Donnees.live; %>
  <% if (live && live.vehicules && live.vehicules.filter((v) => !v.archive).length) { %>
  <h4>🖨️ Attestations d’assurance (carte rose)</h4>
  <ul><% live.vehicules.filter((v) => !v.archive).forEach((v) => { %>
    <li><%= v.annee || '' %> <%= v.marque || '' %> <%= v.modele || '' %> (<%= v.vin || 'sans VIN' %>)
      — <a href="/polices/<%= police.id %>/attestation/<%= v.id %>" target="_blank" rel="noopener">Imprimer l’attestation</a></li>
  <% }) %></ul>
  <% } %>
</div>
<% } %>

<% if (biensDonnees) { %>
<div class="carte">
  <h3>🏢 Données biens</h3>
  <p class="petit">Figées à la conversion (soumission biens
    <a href="/biens/<%= police.biens_soumission_id %>">#<%= police.biens_soumission_id %></a>,
    version <%= police.biens_soumission_version ? 'v' + police.biens_soumission_version : '—' %>
    <% if (police.biens_soumission_version) { %>(<a href="/biens/<%= police.biens_soumission_id %>/versions/<%= police.biens_soumission_version %>">voir le snapshot</a>)<% } %>).
    Les avenants en cours de terme se font sur la soumission et créent automatiquement une nouvelle version de cette police.</p>
  <% const bfig = (biensDonnees.versionFige && biensDonnees.versionFige.donnees) || { batiments: [], contenus_generaux: [] }; %>
  <h4>Bâtiments (<%= bfig.batiments.length %>)</h4>
  <% if (bfig.batiments.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Adresse</th><th>Construction</th><th>Année</th><th>Superficie</th><th>Occupation</th><th>Valeur</th><th>Garanties</th></tr></thead>
    <tbody><% bfig.batiments.forEach((b) => { %>
      <tr><td><%= b.adresse || '—' %><%= b.ville ? ', ' + b.ville : '' %></td>
      <td><%= (biensDonnees.NOMS_TYPE_CONSTRUCTION[b.type_construction] || b.type_construction || '—') %></td>
      <td><%= b.annee_construction || '—' %></td>
      <td><%= b.superficie_pi2 != null ? Number(b.superficie_pi2).toLocaleString('fr-CA') + ' pi²' : '—' %></td>
      <td><%= b.occupation || '—' %></td>
      <td><%= b.valeur_batiment != null ? Number(b.valeur_batiment).toLocaleString('fr-CA') + ' $' : '—' %></td>
      <td><% const g = b.garanties || {};
        %><%= g.formule ? (biensDonnees.NOMS_FORMULE[g.formule] || g.formule) : '—' %><%= g.franchise != null ? ' · fr. ' + Number(g.franchise).toLocaleString('fr-CA') + ' $' : '' %><%= g.montant_assurance != null ? ' · ' + Number(g.montant_assurance).toLocaleString('fr-CA') + ' $' : '' %><% const avb = g.avenants || {}; const codesb = Object.keys(avb);
        %><%= codesb.length ? ' · ' + codesb.map((c) => { const f = biensDonnees.AVENANTS_BIENS.find(([code]) => code === c); return f ? f[1] : c; }).join(', ') : '' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %><p class="petit">Aucun bâtiment au snapshot de conversion.</p><% } %>
  <h4>Contenus</h4>
  <% const tousContenus = [];
     bfig.batiments.forEach((b) => { (b.contenus || []).forEach((c) => { tousContenus.push({ ...c, batiment: b.adresse }); }); });
     (bfig.contenus_generaux || []).forEach((c) => { tousContenus.push({ ...c, batiment: '—' }); }); %>
  <% if (tousContenus.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Description</th><th>Type</th><th>Valeur</th><th>Bâtiment</th></tr></thead>
    <tbody><% tousContenus.forEach((c) => { %>
      <tr><td><%= c.description || '—' %></td>
      <td><%= biensDonnees.NOMS_TYPE_CONTENU[c.type_contenu] || c.type_contenu || '—' %></td>
      <td><%= c.valeur != null ? Number(c.valeur).toLocaleString('fr-CA') + ' $' : '—' %></td>
      <td><%= c.batiment || '—' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %><p class="petit">Aucun contenu au snapshot de conversion.</p><% } %>
  <% const ant = bfig.antecedents || null; %>
  <% if (ant) { %>
  <h4>Antécédents d’assurance</h4>
  <dl class="dl">
    <dt>Assureur actuel</dt><dd><%= ant.assureur_actuel || '—' %></dd>
    <dt>Police actuelle</dt><dd><%= ant.numero_police_actuelle || '—' %></dd>
    <dt>Années d’assurance continue</dt><dd><%= ant.annees_assurance_continue != null ? ant.annees_assurance_continue : '—' %></dd>
    <dt>Sinistres (5 ans)</dt><dd><% const sin = ant.sinistres_5ans || []; %><%= sin.length ? sin.map((x) => [x.date, x.type, x.montant != null ? Number(x.montant).toLocaleString('fr-CA') + ' $' : null].filter(Boolean).join(' — ')).join(' ; ') : 'Aucun' %></dd>
  </dl>
  <% } %>
</div>
<% } %>

<% if (rcDonnees) { %>
<div class="carte">
