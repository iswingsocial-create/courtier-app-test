      </form></li>
  <% }) %></ul>
  <% } %>
  <% if (documentsArchives.length) { %>
  <h4 class="petit">Documents archivés</h4>
  <ul><% documentsArchives.forEach((d) => { %>
    <li><span class="petit"><%= d.nom_origine %></span>
      <form method="post" action="/polices/<%= police.id %>/documents/<%= d.id %>/desarchiver" class="inline" data-confirm="Désarchiver ce document ?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="lien" type="submit">désarchiver</button>
      </form></li>
  <% }) %></ul>
  <% } %>
</div>

<div class="carte">
  <h3>✉️ Courriels liés (<%= courrielsLies.length %>)</h3>
  <% if (courrielsLies.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Date</th><th>De / À</th><th>Sujet</th><th></th></tr></thead>
    <tbody><% courrielsLies.forEach((cm) => { %>
      <tr>
        <td class="petit"><%= (cm.date_courriel || cm.cree_le || '').slice(0, 16).replace('T', ' ') %></td>
        <td><%= cm.dossier === 'envoyes' ? 'À : ' + (cm.destinataires || '') : cm.expediteur %></td>
        <td><a href="/courriels/<%= cm.id %>"><%= cm.sujet %></a></td>
        <td><a class="btn btn-petit btn-secondaire" href="/courriels/<%= cm.id %>">Ouvrir</a></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } else { %>
  <p class="petit">Aucun courriel n’est encore rattaché à cette police. Les courriels reçus qui mentionnent le numéro de police <strong><%= police.numero_police %></strong> (avis d’assureur, note de couverture, certificat…) se classent ici automatiquement ; vous pouvez aussi lier un message à cette police depuis le module Courriels.</p>
  <% } %>
</div>

<div class="carte">
  <h3>🔍 Vérification de l'avenant (<%= verificationsPolice.length %>)</h3>
  <p class="petit">Quand l'assureur retourne son document (avenant, note de couverture), faites-le comparer automatiquement à ce qui lui avait été demandé — l'état courant de cette fiche. Le rapport signale les <strong>écarts</strong>, les éléments <strong>absents</strong> et ceux <strong>à confirmer</strong> ; rien n'est décidé sans vous.</p>
  <% if (verificationsPolice.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Date</th><th>Source</th><th>Résultat</th><th>Vérifiée</th><th></th></tr></thead>
    <tbody><% verificationsPolice.forEach((v) => { const c = (v.rapport && v.rapport.compteurs) || {}; %>
      <tr>
        <td class="petit"><%= (v.cree_le || '').slice(0, 16).replace('T', ' ') %></td>
        <td><%= v.source_type === 'piece_jointe_courriel' ? 'Pièce jointe de courriel' : 'Document déposé' %></td>
        <td><span class="badge <%= v.statut === 'conforme' ? 'badge-ok' : (v.statut === 'ecarts' ? 'badge-echu' : 'badge-j') %>"><%= NOMS_STATUTS_VERIF[v.statut] || v.statut %></span>
          <span class="petit"><%= (c.ecart || 0) + (c.absent || 0) + (c.surplus || 0) %> écart(s), <%= c.a_confirmer || 0 %> à confirmer</span></td>
        <td class="petit"><%= v.verifiee_le ? 'Oui, le ' + v.verifiee_le.slice(0, 10) + (v.verifiee_par_nom ? ' par ' + v.verifiee_par_nom : '') : 'Non' %></td>
        <td><a class="btn btn-petit btn-secondaire" href="/echeances/police/<%= police.id %>/verifications/<%= v.id %>">Rapport</a></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
  <h4>Vérifier le document de l'assureur</h4>
  <form method="post" action="/echeances/police/<%= police.id %>/verifier-document" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="docav">Déposer le document retourné (PDF, image, Word, Excel — max 15 Mo)</label>
    <input type="file" id="docav" name="document" required>
    <div class="actions"><button class="btn btn-petit" type="submit">🔍 Analyser et comparer</button></div>
  </form>
  <% if (piecesJointesPolice.length) { %>
  <form method="post" action="/echeances/police/<%= police.id %>/verifier-piece-jointe">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="pjverif">…ou vérifier une pièce jointe d'un courriel lié à cette police</label>
    <select id="pjverif" name="piece_jointe_id">
      <% piecesJointesPolice.forEach((pj) => { %>
        <option value="<%= pj.id %>"><%= pj.nom %> — courriel « <%= pj.sujet || 'sans objet' %> »</option>
      <% }) %>
    </select>
    <div class="actions"><button class="btn btn-petit btn-secondaire" type="submit">🔍 Vérifier cette pièce jointe</button></div>
  </form>
  <% } %>
</div>

<div class="carte">
  <h3>✉️ Brouillon de renouvellement (IA)</h3>
  <p class="petit">Génère un message à l’assuré à partir de cette fiche. Il restera un <strong>brouillon à valider</strong> — rien ne s’envoie automatiquement.</p>
  <form method="post" action="/brouillons/generer/<%= police.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="actions"><button class="btn" type="submit">Générer le brouillon</button></div>
  </form>
  <% if (brouillons.length) { %>
    <h3>Brouillons existants</h3>
    <ul><% brouillons.forEach((b) => { %>
      <li><a href="/brouillons/<%= b.id %>"><%= b.sujet %></a>
        <span class="badge <%= b.statut === 'valide' ? 'badge-ok' : 'badge-gris' %>"><%= b.statut %></span>
        <span class="petit"><%= b.cree_le.slice(0, 16).replace('T', ' ') %></span></li>
    <% }) %></ul>
  <% } %>
</div>
<%- include('../partials/bas') %>
