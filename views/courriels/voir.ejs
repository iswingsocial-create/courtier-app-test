<%- include('../partials/haut', { titre: courriel.sujet }) %>
<div class="entete-page">
  <h1>📧 <%= courriel.sujet %></h1>
  <div>
    <a class="btn btn-secondaire btn-petit" href="/courriels<%= courriel.dossier === 'envoyes' ? '/envoyes' : '' %>">← Retour</a>
    <% if (courriel.dossier === 'reception') { %>
      <a class="btn btn-petit" href="/courriels/rediger?reponse_id=<%= courriel.id %>">↩️ Répondre</a>
      <a class="btn btn-petit" href="/courriels/<%= courriel.id %>/analyser-reponse">🤖 Analyser la réponse</a>
    <% } %>
  </div>
</div>
<div class="carte">
  <dl class="fiche">
    <dt>De</dt><dd><%= courriel.expediteur %></dd>
    <dt>À</dt><dd><%= courriel.destinataires %></dd>
    <% if (courriel.cc) { %><dt>Cc</dt><dd><%= courriel.cc %></dd><% } %>
    <dt>Date</dt><dd><%= (courriel.date_courriel || courriel.cree_le || '').slice(0, 16).replace('T', ' ') %></dd>
    <% if (courriel.compte_nom) { %><dt>Compte</dt><dd><%= courriel.compte_nom %></dd><% } %>
    <dt>Entreprise liée</dt>
    <dd>
      <% if (courriel.client_raison_sociale) { %>
        <a href="/clients/<%= courriel.client_id %>"><%= courriel.client_raison_sociale %></a>
      <% } else { %>
        <span class="petit">Aucune</span>
      <% } %>
      <form method="post" action="/courriels/<%= courriel.id %>/lier" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="client_id">
          <option value="">— Choisir une entreprise —</option>
          <% clients.forEach((cl) => { %>
            <option value="<%= cl.id %>" <%= courriel.client_id === cl.id ? 'selected' : '' %>><%= cl.raison_sociale %><%= cl.courriel ? ' (' + cl.courriel + ')' : '' %></option>
          <% }) %>
        </select>
        <% if (policesClient && policesClient.length) { %>
          <select name="police_id">
            <option value="">— Police précise (optionnel) —</option>
            <% policesClient.forEach((p) => { %>
              <option value="<%= p.id %>" <%= courriel.police_id === p.id ? 'selected' : '' %>><%= p.numero_police %> — <%= p.assureur %></option>
            <% }) %>
          </select>
        <% } %>
        <button class="btn btn-petit btn-secondaire" type="submit">Lier</button>
      </form>
      <% if (courriel.client_id && (!policesClient || !policesClient.length)) { %>
        <span class="petit">(cette entreprise n’a pas encore de police au dossier)</span>
      <% } %>
    </dd>
    <% if (courriel.police_numero) { %>
    <dt>Police liée</dt>
    <dd><a href="/echeances/police/<%= courriel.police_id %>">🔗 <%= courriel.police_numero %></a></dd>
    <% } %>
    <dt>Classement</dt>
    <dd>
      <% const badgeMsg = badgeClassement(courriel); %>
      <% if (badgeMsg) { %>
        <span class="badge badge-gris"><%= badgeMsg %></span>
        <span class="petit"><%= NOMS_METHODES_CLASSEMENT[courriel.classement_methode] || '' %><% if (courriel.classement_detail && courriel.classement_methode !== 'numero_police') { %> — <%= courriel.classement_detail %><% } %></span>
      <% } else if (courriel.client_id) { %>
        <span class="petit">Classé (méthode non enregistrée)</span>
      <% } else { %>
        <span class="petit">Non classé — liez-le à une entreprise ci-dessus, ou lancez « ♻️ Reclasser les non classés » depuis la liste.</span>
      <% } %>
    </dd>
  </dl>
</div>
<div class="carte">
  <% if (corpsHtml) { %>
    <div class="courriel-html"><%- corpsHtml %></div>
  <% } else { %>
    <pre class="courriel-texte"><%= courriel.corps_texte || '(message vide)' %></pre>
  <% } %>
</div>
<div class="actions-form">
  <% if (courriel.dossier === 'reception') { %>
    <% if (courriel.lu) { %>
      <form method="post" action="/courriels/<%= courriel.id %>/non-lu" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondaire btn-petit" type="submit">Marquer non lu</button></form>
    <% } %>
    <form method="post" action="/courriels/<%= courriel.id %>/archiver" class="inline" data-confirm="Archiver ce courriel ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondaire btn-petit" type="submit">Archiver</button></form>
  <% } %>
</div>
<%- include('../partials/bas') %>
