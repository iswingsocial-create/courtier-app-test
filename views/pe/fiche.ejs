<%- include('../partials/haut', { titre: 'Soumission perte d’exploitation #' + s.id }) %>
<div class="entete-page">
  <h1>📉 Soumission perte d’exploitation #<%= s.id %></h1>
  <div>
    <span class="badge <%= s.statut === 'convertie_police' ? 'badge-ok' : (s.statut === 'soumise' ? 'badge-j' : 'badge-gris') %>"><%= NOMS_STATUTS_SOUMISSION[s.statut] %></span>
    <a class="btn btn-secondaire btn-petit" href="/pe">← Soumissions</a>
  </div>

</div>
<%- include('../partials/manques', { sectionDemandes }) %>
<%- include('../partials/mise-en-marche', { sectionMarche }) %>


<div class="carte">
  <dl class="dl">
    <dt>Entreprise</dt><dd><strong><%= clientNom %></strong></dd>
    <dt>Date d’effet souhaitée</dt><dd><%= s.date_effet_souhaitee || '—' %></dd>
    <dt>Notes</dt><dd><%= s.notes || '—' %></dd>
    <dt>Créée le</dt><dd><%= (s.cree_le || '').slice(0, 16).replace('T', ' ') %></dd>
  </dl>
  <div class="actions">
    <% Object.keys(NOMS_STATUTS_SOUMISSION).filter((k) => k !== s.statut).forEach((k) => { %>
    <form method="post" action="/pe/<%= s.id %>/statut" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="statut" value="<%= k %>">
      <button class="btn btn-petit btn-secondaire" type="submit">→ <%= NOMS_STATUTS_SOUMISSION[k] %></button>
    </form>
    <% }) %>
    <form method="post" action="/pe/<%= s.id %>/<%= s.archive ? 'desarchiver' : 'archiver' %>" class="inline" data-confirm="<%= s.archive ? 'Désarchiver cette soumission ?' : 'Archiver cette soumission ?' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-petit btn-secondaire" type="submit"><%= s.archive ? 'Désarchiver' : 'Archiver' %></button>
    </form>
    <a class="btn btn-petit" href="/pe/<%= s.id %>/proposition">📄 Proposition</a>
  </div>
</div>

<% if (policeLiee) { %>
<div class="carte">
  <h3>🏛️ Police liée</h3>
  <p>Cette soumission est convertie en <strong>police <%= policeLiee.numero_police %></strong>
    (<%= policeLiee.assureur %>, effet <%= policeLiee.date_effet %> → échéance <%= policeLiee.date_echeance %>).</p>
  <div class="actions"><a class="btn btn-petit" href="/echeances/police/<%= policeLiee.id %>">Ouvrir la fiche de gestion</a></div>
</div>
<% } else if (s.statut !== 'convertie_police') { %>
<div class="carte" id="conversion">
  <h3>🏛️ Convertir en police</h3>
  <p class="petit">Crée la police perte d’exploitation à gérer : les données de la soumission sont figées en référence, puis chaque avenant en cours de terme créera une nouvelle version de la police.</p>
  <form method="post" action="/pe/<%= s.id %>/convertir" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="numero_police">Numéro de police *</label><input type="text" id="numero_police" name="numero_police" required maxlength="60"></div>
    <div><label for="assureur_id">Assureur *</label>
      <select id="assureur_id" name="assureur_id" required>
        <option value="">— Choisir —</option>
        <% assureurs.forEach((a) => { %><option value="<%= a.id %>"><%= a.nom %></option><% }) %>
      </select></div>
    <div><label for="date_effet">Date d’effet *</label><input type="date" id="date_effet" name="date_effet" required value="<%= s.date_effet_souhaitee || '' %>"></div>
    <div><label for="date_echeance">Date d’échéance *</label><input type="date" id="date_echeance" name="date_echeance" required></div>
    <div><label for="franchise">Franchise ($)</label><input type="number" id="franchise" name="franchise" step="0.01" min="0" value="0"></div>
    <div class="actions"><button class="btn" type="submit">Convertir en police</button></div>
  </form>
  <% if (policesDispo.length) { %>
  <h4>Ou lier une police existante</h4>
  <form method="post" action="/pe/<%= s.id %>/lier-police" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="police_id">Police perte d’exploitation de <%= clientNom %></label>
      <select id="police_id" name="police_id" required>
        <% policesDispo.forEach((p) => { %><option value="<%= p.id %>"><%= p.numero_police %></option><% }) %>
      </select></div>
    <div class="actions"><button class="btn btn-secondaire" type="submit">Lier cette police</button></div>
  </form>
  <% } %>
</div>
<% } %>

<div class="carte" id="etablissements">
  <div class="entete-page"><h2>🏭 Établissements assurés (<%= s.etablissements.filter((e) => !e.archive).length %>)</h2>
    <div><button type="button" class="btn btn-petit" data-toggle-cible="form-etablissement">+ Ajouter un établissement</button></div></div>

  <div id="form-etablissement" hidden>
    <form method="post" action="/pe/<%= s.id %>/etablissement" class="grille-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label>Nom du lieu *</label>
        <input type="text" name="nom_lieu" maxlength="120" placeholder="Ex. : Fournil, magasin, entrepôt"></div>
      <div><label>Adresse</label>
        <input type="text" name="adresse" maxlength="200" placeholder="Ex. : 123 rue Sainte-Catherine E, Montréal"></div>
      <div><label>Occupation / activité à ce lieu</label>
        <input type="text" name="occupation" maxlength="200" placeholder="Ex. : Boulangerie — fournil"></div>
      <div><label>Chiffre d’affaires du lieu ($)</label>
        <input type="number" name="chiffre_affaires" min="0" step="0.01"></div>
      <div><label>Montant de perte d’exploitation du lieu ($)</label>
        <input type="number" name="montant_pe" min="0" step="0.01"></div>
      <div><label>Superficie (m²)</label>
        <input type="number" name="superficie" min="0" step="0.01"></div>
      <div><label>Année de construction</label>
        <input type="number" name="annee_construction" min="1600" max="2100" step="1"></div>
      <div><label>Base de valeur</label>
        <select name="base_valeur">
          <option value="">— Choisir —</option>
          <% BASES_VALEUR.forEach((b) => { %><option value="<%= b %>"><%= NOMS_BASE_VALEUR[b] %></option><% }) %>
        </select></div>
      <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Ajouter cet établissement</button></div>
    </form>
  </div>

  <div class="tableau-deroulant"><table>
    <thead><tr><th>Lieu</th><th>Occupation</th><th>Chiffre d’affaires</th><th>Superficie</th><th>Base de valeur</th><th></th></tr></thead>
    <tbody>
    <% s.etablissements.filter((e) => !e.archive).forEach((e) => { %>
      <tr>
        <td><strong><%= e.nom_lieu || '—' %></strong><% if (e.adresse) { %><br><span class="petit"><%= e.adresse %></span><% } %><% if (e.annee_construction) { %><br><span class="petit">Construit en <%= e.annee_construction %></span><% } %></td>
        <td><%= e.occupation || '—' %></td>
        <td><%= e.chiffre_affaires !== null && e.chiffre_affaires !== undefined ? Number(e.chiffre_affaires).toLocaleString('fr-CA') + ' $' : '—' %></td>
        <td><%= e.superficie !== null && e.superficie !== undefined ? Number(e.superficie).toLocaleString('fr-CA') + ' m²' : '—' %></td>
        <td><%= e.base_valeur ? NOMS_BASE_VALEUR[e.base_valeur] : '—' %></td>
        <td style="white-space:nowrap">
          <button type="button" class="btn btn-petit btn-secondaire" data-toggle-cible="modif-etablissement-<%= e.id %>">Modifier</button>
          <form method="post" action="/pe/etablissement/<%= e.id %>/archiver" class="inline" data-confirm="Archiver cet établissement ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form>
        </td>
      </tr>
      <tr id="modif-etablissement-<%= e.id %>" hidden><td colspan="6">
        <form method="post" action="/pe/etablissement/<%= e.id %>" class="grille-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>Nom du lieu *</label>
            <input type="text" name="nom_lieu" maxlength="120" value="<%= e.nom_lieu || '' %>"></div>
          <div><label>Adresse</label>
            <input type="text" name="adresse" maxlength="200" value="<%= e.adresse || '' %>"></div>
          <div><label>Occupation / activité à ce lieu</label>
            <input type="text" name="occupation" maxlength="200" value="<%= e.occupation || '' %>"></div>
          <div><label>Chiffre d’affaires du lieu ($)</label>
            <input type="number" name="chiffre_affaires" min="0" step="0.01" value="<%= e.chiffre_affaires !== null && e.chiffre_affaires !== undefined ? e.chiffre_affaires : '' %>"></div>
          <div><label>Montant de perte d’exploitation du lieu ($)</label>
            <input type="number" name="montant_pe" min="0" step="0.01" value="<%= e.montant_pe !== null && e.montant_pe !== undefined ? e.montant_pe : '' %>"></div>
          <div><label>Superficie (m²)</label>
            <input type="number" name="superficie" min="0" step="0.01" value="<%= e.superficie !== null && e.superficie !== undefined ? e.superficie : '' %>"></div>
          <div><label>Année de construction</label>
            <input type="number" name="annee_construction" min="1600" max="2100" step="1" value="<%= e.annee_construction !== null && e.annee_construction !== undefined ? e.annee_construction : '' %>"></div>
          <div><label>Base de valeur</label>
            <select name="base_valeur">
              <option value="">— Choisir —</option>
              <% BASES_VALEUR.forEach((b) => { %><option value="<%= b %>"<%= e.base_valeur === b ? ' selected' : '' %>><%= NOMS_BASE_VALEUR[b] %></option><% }) %>
            </select></div>
          <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Enregistrer</button></div>
        </form>
      </td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (!s.etablissements.filter((e) => !e.archive).length) { %><p class="petit">Aucun établissement pour l’instant.</p><% } %>
  <% const etabArch = s.etablissements.filter((e) => e.archive); %>
  <% if (etabArch.length) { %><p class="petit">Archivés : <% etabArch.forEach((e, i) => { %><%= i ? ', ' : '' %><%= e.nom_lieu || e.adresse %> <form method="post" action="/pe/etablissement/<%= e.id %>/desarchiver" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="lien" type="submit">restaurer</button></form><% }) %></p><% } %>
</div>

<div class="carte" id="garanties">
  <h2>📜 Garanties</h2>
  <% const g = s.garanties; %>
  <% if (g) { %><p class="petit">Actuel : limite <%= g.limite ? Number(g.limite).toLocaleString('fr-CA') + ' $' : '—' %> · période d’indemnité <%= g.periode_indemnite_mois ? g.periode_indemnite_mois + ' mois' : '—' %> · franchise <%= g.franchise_jours !== null && g.franchise_jours !== undefined ? g.franchise_jours + ' jours' : '—' %> · base <%= g.base_montant ? NOMS_BASE_MONTANT[g.base_montant] : '—' %></p><% } %>
  <form method="post" action="/pe/<%= s.id %>/garanties" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="limite">Limite ($)</label>
      <input type="number" id="limite" name="limite" min="0" step="0.01" value="<%= g && g.limite !== null && g.limite !== undefined ? g.limite : '' %>"></div>
    <div><label for="franchise-jours">Franchise — délai de carence (jours)</label>
      <input type="number" id="franchise-jours" name="franchise_jours" min="0" step="1" value="<%= g && g.franchise_jours !== null && g.franchise_jours !== undefined ? g.franchise_jours : '' %>"></div>
    <div><label for="prime">Prime ($, si connue)</label>
      <input type="number" id="prime" name="prime" min="0" step="0.01" value="<%= g && g.prime !== null && g.prime !== undefined ? g.prime : '' %>"></div>
    <div><label for="formule-pe">Formule</label>
      <select id="formule-pe" name="formule">
        <option value="">—</option>
        <% (typeof FORMULES_PE !== 'undefined' ? FORMULES_PE : ['pertes_loyers', 'benefice_brut', 'formule_etendue']).forEach((f) => { %><option value="<%= f %>"<%= g && g.formule === f ? ' selected' : '' %>><%= ({pertes_loyers: 'Pertes de loyers', benefice_brut: 'Bénéfice brut', formule_etendue: 'Formule étendue'})[f] %></option><% }) %>
      </select></div>
    <div><label for="rp-pe">Règle proportionnelle (%)</label>
      <input type="number" id="rp-pe" name="regle_proportionnelle" min="0" max="100" step="0.01" value="<%= g && g.regle_proportionnelle != null ? g.regle_proportionnelle : '' %>"></div>
    <div><label for="hc-pe">Honoraires de comptables ($)</label>
      <input type="number" id="hc-pe" name="honoraires_comptables" min="0" step="0.01" value="<%= g && g.honoraires_comptables != null ? g.honoraires_comptables : '' %>"></div>
    <div style="grid-column:1/-1"><span class="petit">Période d’indemnité</span><br>
      <% PERIODES_INDEMNITE_MOIS.forEach((mois, i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="radio" id="periode-<%= i %>" name="periode_indemnite_mois" value="<%= mois %>"<%= g && Number(g.periode_indemnite_mois) === mois ? ' checked' : '' %>><label for="periode-<%= i %>"><%= NOMS_PERIODE_INDEMNITE[mois] %></label></span>
      <% }) %></div>
    <div style="grid-column:1/-1"><span class="petit">Base d’indemnité (base du montant)</span><br>
      <% BASES_MONTANT.forEach((b, i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="radio" id="base-<%= i %>" name="base_montant" value="<%= b %>"<%= g && g.base_montant === b ? ' checked' : '' %>><label for="base-<%= i %>"><%= NOMS_BASE_MONTANT[b] %></label></span>
      <% }) %></div>
    <div style="grid-column:1/-1"><span class="petit">Avenants</span><br>
      <% AVENANTS_PE.forEach(([code, libelle], i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="av-<%= i %>" name="avenants" value="<%= code %>"<%= g && g.avenants && g.avenants[code] ? ' checked' : '' %>><label for="av-<%= i %>"><%= libelle %></label></span>
      <% }) %></div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les garanties</button></div>
  </form>
</div>

<div class="carte" id="calcul">
  <h2>🧮 Feuille de calcul de la perte d’exploitation</h2>
  <p class="petit">Structure du formulaire de mise à jour de l’assureur : A1 recettes brutes, A2 recettes ajustées,
  B autres revenus, D dépenses variables déduites (une ligne par poste : libellé et montant alignés), E/G masse salariale.
  Le revenu d’entreprise <strong>F = A2 + B − ΣD</strong> est calculé automatiquement.</p>
  <% const c = (typeof calculPe !== 'undefined' ? calculPe : null); %>
  <% if (c && c.revenu_entreprise_f !== null) { %><p>Revenu d’entreprise calculé (F) : <strong><%= Number(c.revenu_entreprise_f).toLocaleString('fr-CA') %> $</strong></p><% } %>
  <form method="post" action="/pe/<%= s.id %>/calcul">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grille-form">
      <div><label for="recettes_a1">A1 — Recettes brutes ($)</label>
        <input type="number" id="recettes_a1" name="recettes_a1" step="0.01" value="<%= c && c.recettes_a1 != null ? c.recettes_a1 : '' %>"></div>
      <div><label for="recettes_a2">A2 — Recettes ajustées ($)</label>
        <input type="number" id="recettes_a2" name="recettes_a2" step="0.01" value="<%= c && c.recettes_a2 != null ? c.recettes_a2 : '' %>"></div>
      <div><label for="autres_revenus_b">B — Autres revenus ($)</label>
        <input type="number" id="autres_revenus_b" name="autres_revenus_b" step="0.01" value="<%= c && c.autres_revenus_b != null ? c.autres_revenus_b : '' %>"></div>
      <div><label for="salaires_e_montant">E — Masse salariale ordinaire ($)</label>
        <input type="number" id="salaires_e_montant" name="salaires_e_montant" step="0.01" value="<%= c && c.salaires_e_montant != null ? c.salaires_e_montant : '' %>"></div>
      <div><label for="salaires_e_jours">E — Jours couverts</label>
        <input type="number" id="salaires_e_jours" name="salaires_e_jours" value="<%= c && c.salaires_e_jours != null ? c.salaires_e_jours : '' %>"></div>
      <div><label for="salaires_g_montant">G — Salaires en double ($)</label>
        <input type="number" id="salaires_g_montant" name="salaires_g_montant" step="0.01" value="<%= c && c.salaires_g_montant != null ? c.salaires_g_montant : '' %>"></div>
      <div><label for="salaires_g_jours">G — Jours couverts</label>
        <input type="number" id="salaires_g_jours" name="salaires_g_jours" value="<%= c && c.salaires_g_jours != null ? c.salaires_g_jours : '' %>"></div>
      <div><label for="depenses_libelles">D — Dépenses variables : libellés (un par ligne, D1 à D10)</label>
        <textarea id="depenses_libelles" name="depenses_libelles" rows="5"><%= c ? (c.depenses_variables || []).map((d) => d.libelle || '').join('\n') : '' %></textarea></div>
      <div><label for="depenses_montants">D — Montants ($), alignés ligne à ligne</label>
        <textarea id="depenses_montants" name="depenses_montants" rows="5"><%= c ? (c.depenses_variables || []).map((d) => (d.montant != null ? d.montant : '')).join('\n') : '' %></textarea></div>
    </div>
    <div class="actions"><button class="btn btn-petit" type="submit">Enregistrer et calculer F</button></div>
  </form>
</div>
<div class="carte" id="antecedents">
  <h2>📋 Antécédents d’assurance</h2>
  <% const a = s.antecedents; %>
  <form method="post" action="/pe/<%= s.id %>/antecedents" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="ass-actuel">Assureur actuel</label>
      <input type="text" id="ass-actuel" name="assureur_actuel" maxlength="120" value="<%= a && a.assureur_actuel ? a.assureur_actuel : '' %>"></div>
    <div><label for="pol-actuelle">N° de police actuelle</label>
      <input type="text" id="pol-actuelle" name="numero_police_actuelle" maxlength="60" value="<%= a && a.numero_police_actuelle ? a.numero_police_actuelle : '' %>"></div>
    <div><label for="exp-actuelle">Expiration</label>
      <input type="date" id="exp-actuelle" name="date_expiration_actuelle" value="<%= a && a.date_expiration_actuelle ? a.date_expiration_actuelle : '' %>"></div>
    <div><label for="annees-cont">Années d’assurance continue</label>
      <input type="number" id="annees-cont" name="annees_assurance_continue" min="0" max="80" value="<%= a && a.annees_assurance_continue !== null && a.annees_assurance_continue !== undefined ? a.annees_assurance_continue : '' %>"></div>
    <div style="grid-column:1/-1"><label for="interruptions">Interruptions des 5 dernières années</label>
      <textarea id="interruptions" name="interruptions" rows="4" placeholder="Une interruption par ligne : AAAA-MM-JJ | cause | durée (jours) | montant $&#10;Ex. : 2022-03-11 | Bris d’équipement (four) | 6 | 28000"><%= interruptionsTexte %></textarea>
      <span class="petit">Format : date | cause | durée en jours | montant. Laissez vide s’il n’y a eu aucune interruption.</span></div>
    <div style="grid-column:1/-1"><span class="petit">Consentements</span><br>
      <% CONSENTEMENTS_PE.forEach(([code, libelle], i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="cons-<%= i %>" name="consentement_<%= code %>"<%= a && a.consentements && a.consentements[code] ? ' checked' : '' %>><label for="cons-<%= i %>"><%= libelle %></label></span>
      <% }) %></div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les antécédents</button></div>
  </form>
</div>

<div class="carte" id="versions">
  <h2>🕘 Historique des versions</h2>
  <p class="petit">Chaque enregistrement fige une version : rien n’est jamais modifié ni effacé.</p>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Version</th><th>Statut</th><th>Créée le</th><th>Par</th><th></th></tr></thead>
    <tbody>
    <% versions.forEach((v) => { %>
      <tr>
        <td><strong>v<%= v.version %></strong></td>
        <td><%= NOMS_STATUTS_SOUMISSION[v.statut] || v.statut %></td>
        <td><%= (v.cree_le || '').slice(0, 16).replace('T', ' ') %></td>
        <td><%= v.auteur || '—' %></td>
        <td><a class="btn btn-petit btn-secondaire" href="/pe/<%= s.id %>/versions/<%= v.version %>">Voir</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/bas') %>
