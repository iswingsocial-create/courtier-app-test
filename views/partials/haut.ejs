<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof titre !== 'undefined' ? titre + ' — ' : '' %>Courtier</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (typeof utilisateur !== 'undefined' && utilisateur) { %>
<%
  // Menu principal par sections métier : un lien direct (Échéances, l'écran
  // du travail quotidien) puis des sections dépliantes (<details> natif —
  // aucun JavaScript requis). La section de la page courante s'ouvre par
  // défaut et son libellé est souligné ; le lien courant est surligné.
  const SECTIONS_MENU = [
    { id: 'clients', libelle: '👥 Clients', liens: [['/clients', 'Entreprises'], ['/leads', 'Leads']] },
    { id: 'soumissions', libelle: '📝 Soumissions', liens: [['/auto', 'Auto'], ['/biens', 'Biens'], ['/rc', 'RC'], ['/cyber', 'Cyber'], ['/eo', 'E&O'], ['/do', 'D&O'], ['/pe', "Perte d'exploitation"], ['/flotte', 'Flotte'], ['/cautionnement', 'Cautionnement'], ['/combinees', 'Combinée']] },
    { id: 'polices', libelle: '🛡️ Polices', liens: [['/polices', 'Polices'], ['/reclamations', 'Réclamations']] },
    { id: 'communications', libelle: '✉️ Communications', liens: [['/courriels', 'Courriels'], ['/brouillons', 'Brouillons'], ['/campagnes', 'Campagnes'], ['/reunions', 'Réunions']] },
    { id: 'outils-ia', libelle: '🤖 Outils IA', liens: [['/ouverture', '🎙️ Ouvrir un dossier'], ['/analyses', '📥 Analyser un document'], ['/assistant', 'Assistant IA']] },
    { id: 'gestion', libelle: '🗂️ Gestion', liens: [['/assureurs', 'Assureurs'], ['/factures', 'Facturation'], ['/taches', 'Tâches'], ['/import', 'Import'], ['/exports', 'Exports']] },
  ];
  if (utilisateur.role === 'admin') {
    SECTIONS_MENU.push({ id: 'admin', libelle: '⚙️ Admin', liens: [['/admin/utilisateurs', 'Admin'], ['/admin/journal', 'Journal'], ['/admin/cohere', '🔑 Clé IA'], ['/admin/cabinets', 'Cabinets'], ['/admin/dictionnaire', 'Dictionnaire']] });
  }
  const cheminMenu = (typeof cheminActuel !== 'undefined' && cheminActuel) ? cheminActuel : '';
  const estCourant = (url) => url === '/echeances'
    ? (cheminMenu === '/' || cheminMenu.startsWith('/echeances'))
    : cheminMenu.startsWith(url);
%>
<header class="barre-haut">
  <a class="logo" href="/echeances">🛡️ Courtier</a>
  <nav class="menu-sections">
    <a class="menu-direct<%= estCourant('/echeances') ? ' actif' : '' %>" href="/echeances">Échéances</a>
    <% for (const section of SECTIONS_MENU) { const sectionCourante = section.liens.some(([url]) => estCourant(url)); %>
    <details class="menu-section" data-section="<%= section.id %>"<%= sectionCourante ? ' open' : '' %>>
      <summary<%- sectionCourante ? ' class="courant"' : '' %>><%- section.libelle %></summary>
      <div class="menu-liens">
        <% for (const [url, libelle] of section.liens) { %><a<%- estCourant(url) ? ' class="actif"' : '' %> href="<%= url %>"><%- libelle %></a><% } %>
      </div>
    </details>
    <% } %>
  </nav>
  <div class="utilisateur">
    <span><%= utilisateur.cabinet_nom %></span>
    <a href="/profil/deux-facteurs"><%= utilisateur.nom %></a>
    <form method="post" action="/deconnexion" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="lien" type="submit">Déconnexion</button></form>
  </div>
</header>
<% } %>
<main class="<%= typeof etroit !== 'undefined' && etroit ? 'conteneur-etroit' : 'conteneur' %>">
