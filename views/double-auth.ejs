<%- include('partials/haut', { titre: 'Double authentification', etroit: true }) %>
<div class="carte">
  <h2>🔐 Vérification en deux étapes</h2>
  <p>Ouvrez votre application d’authentification et saisissez le code à 6 chiffres.</p>
  <% if (erreur) { %><div class="alerte alerte-erreur"><%= erreur %></div><% } %>
  <form method="post" action="/double-auth">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="retour" value="<%= retour %>">
    <label for="code">Code</label>
    <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="10">
    <div class="actions"><button class="btn" type="submit">Vérifier</button></div>
  </form>
</div>
<%- include('partials/bas') %>
