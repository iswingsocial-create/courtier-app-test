<%- include('../partials/haut', { titre: 'Soumission biens #' + s.id }) %>
<div class="entete-page">
  <h1>🏢 Soumission biens #<%= s.id %></h1>
  <div>
    <span class="badge <%= s.statut === 'convertie_police' ? 'badge-ok' : (s.statut === 'soumise' ? 'badge-j' : 'badge-gris') %>"><%= NOMS_STATUTS_SOUMISSION[s.statut] %></span>
    <a class="btn btn-secondaire btn-petit" href="/biens">← Soumissions</a>
  </div>

</div>
<%- include('../partials/manques', { sectionDemandes }) %>
<%- include('../partials/mise-en-marche', { sectionMarche }) %>


<div class="carte">
  <dl class="dl">
    <dt>Entreprise</dt><dd><strong><%= clientNom %></strong></dd>
    <dt>Date d’effet souhaitée</dt><dd><%= s.date_effet_souhaitee || '—' %></dd>
    <dt>Notes</dt><dd><%= s.notes || '—' %></dd>
    <dt>Créée le</dt><dd><%= (s.cree_le || '').slice(0, 16).replace('T', ' ') %></dd>
  </dl>
  <div class="actions">
    <% Object.keys(NOMS_STATUTS_SOUMISSION).filter((k) => k !== s.statut).forEach((k) => { %>
    <form method="post" action="/biens/<%= s.id %>/statut" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="statut" value="<%= k %>">
      <button class="btn btn-petit btn-secondaire" type="submit">→ <%= NOMS_STATUTS_SOUMISSION[k] %></button>
    </form>
    <% }) %>
    <form method="post" action="/biens/<%= s.id %>/<%= s.archive ? 'desarchiver' : 'archiver' %>" class="inline" data-confirm="<%= s.archive ? 'Désarchiver cette soumission ?' : 'Archiver cette soumission ?' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-petit btn-secondaire" type="submit"><%= s.archive ? 'Désarchiver' : 'Archiver' %></button>
    </form>
    <a class="btn btn-petit" href="/biens/<%= s.id %>/proposition">📄 Proposition</a>
  </div>
</div>

<% if (policeLiee) { %>
<div class="carte">
  <h3>🏛️ Police liée</h3>
  <p>Cette soumission est convertie en <strong>police <%= policeLiee.numero_police %></strong>
    (<%= policeLiee.assureur %>, effet <%= policeLiee.date_effet %> → échéance <%= policeLiee.date_echeance %>).</p>
  <div class="actions"><a class="btn btn-petit" href="/echeances/police/<%= policeLiee.id %>">Ouvrir la fiche de gestion</a></div>
</div>
<% } else if (s.statut !== 'convertie_police') { %>
<div class="carte" id="conversion">
  <h3>🏛️ Convertir en police</h3>
  <p class="petit">Crée la police biens commerciaux à gérer : les données de la soumission sont figées en référence, puis chaque avenant en cours de terme créera une nouvelle version de la police.</p>
  <form method="post" action="/biens/<%= s.id %>/convertir" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="numero_police">Numéro de police *</label><input type="text" id="numero_police" name="numero_police" required maxlength="60"></div>
    <div><label for="assureur_id">Assureur *</label>
      <select id="assureur_id" name="assureur_id" required>
        <option value="">— Choisir —</option>
        <% assureurs.forEach((a) => { %><option value="<%= a.id %>"><%= a.nom %></option><% }) %>
      </select></div>
    <div><label for="date_effet">Date d’effet *</label><input type="date" id="date_effet" name="date_effet" required value="<%= s.date_effet_souhaitee || '' %>"></div>
    <div><label for="date_echeance">Date d’échéance *</label><input type="date" id="date_echeance" name="date_echeance" required></div>
    <div><label for="franchise">Franchise ($)</label><input type="number" id="franchise" name="franchise" step="0.01" min="0" value="0"></div>
    <div class="actions"><button class="btn" type="submit">Convertir en police</button></div>
  </form>
  <% if (policesDispo.length) { %>
  <h4>Ou lier une police existante</h4>
  <form method="post" action="/biens/<%= s.id %>/lier-police" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="police_id">Police biens de <%= clientNom %></label>
      <select id="police_id" name="police_id" required>
        <% policesDispo.forEach((p) => { %><option value="<%= p.id %>"><%= p.numero_police %></option><% }) %>
      </select></div>
    <div class="actions"><button class="btn btn-secondaire" type="submit">Lier cette police</button></div>
  </form>
  <% } %>
</div>
<% } %>

<div class="carte" id="batiments">
  <div class="entete-page"><h2>🏚️ Bâtiments (<%= s.batiments.filter((b) => !b.archive).length %>)</h2>
    <div><button type="button" class="btn btn-petit" data-toggle-cible="form-batiment">+ Ajouter un bâtiment</button></div></div>

  <div id="form-batiment" hidden>
    <form method="post" action="/biens/<%= s.id %>/batiment" class="grille-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label>Adresse *</label><input type="text" name="adresse" required maxlength="200"></div>
      <div><label>Ville</label><input type="text" name="ville" maxlength="100"></div>
      <div><label>Code postal</label><input type="text" name="code_postal" maxlength="12"></div>
      <div><label>Type de construction</label><select name="type_construction"><option value="">—</option>
        <% TYPES_CONSTRUCTION.forEach((t) => { %><option value="<%= t %>"><%= NOMS_TYPE_CONSTRUCTION[t] %></option><% }) %>
      </select></div>
      <div><label>Année de construction</label><input type="number" name="annee_construction" min="1800" max="2035"></div>
      <div><label>Superficie (pi²)</label><input type="number" name="superficie_pi2" min="0" step="0.01"></div>
      <div><label>Nombre d’étages</label><input type="number" name="nb_etages" min="0"></div>
      <div><label>Occupation</label><input type="text" name="occupation" maxlength="120" placeholder="Bureau, entrepôt, restaurant…"></div>
      <div><label>Valeur du bâtiment ($)</label><input type="number" name="valeur_batiment" min="0" step="0.01"></div>
      <div><label>Distance de la caserne (km)</label><input type="number" name="distance_caserne_km" min="0" step="0.1"></div>
      <div><label>Chauffage</label><input type="text" name="chauffage" maxlength="80" placeholder="Électrique, gaz, huile…"></div>
      <div><label>Année de la toiture</label><input type="number" name="annee_toiture" min="1800" max="2035"></div>
      <div class="case"><input type="checkbox" id="b-gicleurs" name="gicleurs"><label for="b-gicleurs">Gicleurs (protection incendie)</label></div>
      <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"></textarea></div>
      <%- include('_batiment-enrichi', { b: null, p: 'nb' }) %>
      <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Ajouter ce bâtiment</button></div>
    </form>
  </div>

  <div class="tableau-deroulant"><table>
    <thead><tr><th>Adresse</th><th>Construction</th><th>Année</th><th>Superficie</th><th>Occupation</th><th>Gicleurs</th><th></th></tr></thead>
    <tbody>
    <% s.batiments.filter((b) => !b.archive).forEach((b) => { %>
      <tr>
        <td><strong><%= b.adresse %></strong><br><span class="petit"><%= [b.ville, b.code_postal].filter(Boolean).join(', ') %></span></td>
        <td><%= b.type_construction ? NOMS_TYPE_CONSTRUCTION[b.type_construction] : '—' %></td>
        <td><%= b.annee_construction || '—' %></td>
        <td><%= b.superficie_pi2 ? Number(b.superficie_pi2).toLocaleString('fr-CA') + ' pi²' : '—' %></td>
        <td><%= b.occupation || '—' %></td>
        <td><%= b.gicleurs ? 'Oui' : '—' %></td>
        <td style="white-space:nowrap">
          <button type="button" class="btn btn-petit btn-secondaire" data-toggle-cible="modif-batiment-<%= b.id %>">Modifier</button>
          <form method="post" action="/biens/batiment/<%= b.id %>/archiver" class="inline" data-confirm="Archiver ce bâtiment ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form>
        </td>
      </tr>
      <tr id="modif-batiment-<%= b.id %>" hidden><td colspan="7">
        <form method="post" action="/biens/batiment/<%= b.id %>" class="grille-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>Adresse *</label><input type="text" name="adresse" required maxlength="200" value="<%= b.adresse || '' %>"></div>
          <div><label>Ville</label><input type="text" name="ville" maxlength="100" value="<%= b.ville || '' %>"></div>
          <div><label>Code postal</label><input type="text" name="code_postal" maxlength="12" value="<%= b.code_postal || '' %>"></div>
          <div><label>Type de construction</label><select name="type_construction"><option value="">—</option>
            <% TYPES_CONSTRUCTION.forEach((t) => { %><option value="<%= t %>"<%= b.type_construction === t ? ' selected' : '' %>><%= NOMS_TYPE_CONSTRUCTION[t] %></option><% }) %>
          </select></div>
          <div><label>Année de construction</label><input type="number" name="annee_construction" min="1800" max="2035" value="<%= b.annee_construction || '' %>"></div>
          <div><label>Superficie (pi²)</label><input type="number" name="superficie_pi2" min="0" step="0.01" value="<%= b.superficie_pi2 || '' %>"></div>
          <div><label>Nombre d’étages</label><input type="number" name="nb_etages" min="0" value="<%= b.nb_etages || '' %>"></div>
          <div><label>Occupation</label><input type="text" name="occupation" maxlength="120" value="<%= b.occupation || '' %>"></div>
          <div><label>Valeur du bâtiment ($)</label><input type="number" name="valeur_batiment" min="0" step="0.01" value="<%= b.valeur_batiment || '' %>"></div>
          <div><label>Distance de la caserne (km)</label><input type="number" name="distance_caserne_km" min="0" step="0.1" value="<%= b.distance_caserne_km || '' %>"></div>
          <div><label>Chauffage</label><input type="text" name="chauffage" maxlength="80" value="<%= b.chauffage || '' %>"></div>
          <div><label>Année de la toiture</label><input type="number" name="annee_toiture" min="1800" max="2035" value="<%= b.annee_toiture || '' %>"></div>
          <div class="case"><input type="checkbox" id="mb-gicleurs-<%= b.id %>" name="gicleurs"<%= b.gicleurs ? ' checked' : '' %>><label for="mb-gicleurs-<%= b.id %>">Gicleurs</label></div>
          <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"><%= b.notes || '' %></textarea></div>
          <%- include('_batiment-enrichi', { b, p: 'mb' + b.id }) %>
          <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Enregistrer</button></div>
        </form>
      </td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (!s.batiments.filter((b) => !b.archive).length) { %><p class="petit">Aucun bâtiment pour l’instant.</p><% } %>
  <% const batArch = s.batiments.filter((b) => b.archive); %>
  <% if (batArch.length) { %><p class="petit">Archivés : <% batArch.forEach((b, i) => { %><%= i ? ', ' : '' %><%= b.adresse %> <form method="post" action="/biens/batiment/<%= b.id %>/desarchiver" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="lien" type="submit">restaurer</button></form><% }) %></p><% } %>
</div>

<div class="carte" id="alarmes">
  <div class="entete-page"><h2>🚨 Questionnaires alarme (par emplacement)</h2></div>
  <% s.batiments.filter((b) => !b.archive).forEach((b) => { const a = (typeof alarmes !== 'undefined' && alarmes) ? alarmes[b.id] : null; %>
  <details class="details-inline">
    <summary class="btn btn-secondaire btn-petit"><%= b.adresse %><%= a ? ' — alarme renseignée' : ' — à remplir' %></summary>
    <form method="post" action="/biens/batiment/<%= b.id %>/alarme">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grille-form">
        <div><label>Compagnie d’alarme</label><input type="text" name="compagnie_alarme" maxlength="120" value="<%= a ? (a.compagnie_alarme || '') : '' %>"></div>
        <div><label>Téléphone de la compagnie</label><input type="text" name="compagnie_telephone" maxlength="40" value="<%= a ? (a.compagnie_telephone || '') : '' %>"></div>
        <div><label>Courriel de la compagnie</label><input type="email" name="compagnie_courriel" maxlength="120" value="<%= a ? (a.compagnie_courriel || '') : '' %>"></div>
        <div><label>Personne-contact</label><input type="text" name="compagnie_contact" maxlength="120" value="<%= a ? (a.compagnie_contact || '') : '' %>"></div>
        <div><label>Centrale de surveillance (nom et lieu)</label><input type="text" name="centrale_nom_lieu" maxlength="160" value="<%= a ? (a.centrale_nom_lieu || '') : '' %>"></div>
        <div><label>Taux d’interrogation (polling)</label><input type="text" name="taux_interrogation" maxlength="60" value="<%= a ? (a.taux_interrogation || '') : '' %>"></div>
      </div>
      <div class="grille-form">
        <fieldset><legend>Transmission primaire</legend>
          <% LISTES_ALARME.transmissions.forEach((t) => { %>
          <div class="case"><input type="checkbox" name="transmission_primaire" value="<%= t %>" id="tp-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.transmission_primaire) && a.transmission_primaire.includes(t) ? 'checked' : '' %>><label for="tp-<%= b.id %>-<%= t %>"><%= t %></label></div>
          <% }) %>
          <div><label>Fabricant</label><input type="text" name="transmission_primaire_fabricant" maxlength="80" value="<%= a ? (a.transmission_primaire_fabricant || '') : '' %>"></div>
          <div><label>N° de modèle</label><input type="text" name="transmission_primaire_modele" maxlength="80" value="<%= a ? (a.transmission_primaire_modele || '') : '' %>"></div>
        </fieldset>
        <fieldset><legend>Transmission secondaire</legend>
          <% LISTES_ALARME.transmissions.forEach((t) => { %>
          <div class="case"><input type="checkbox" name="transmission_secondaire" value="<%= t %>" id="ts-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.transmission_secondaire) && a.transmission_secondaire.includes(t) ? 'checked' : '' %>><label for="ts-<%= b.id %>-<%= t %>"><%= t %></label></div>
          <% }) %>
          <div><label>Fabricant</label><input type="text" name="transmission_secondaire_fabricant" maxlength="80" value="<%= a ? (a.transmission_secondaire_fabricant || '') : '' %>"></div>
          <div><label>N° de modèle</label><input type="text" name="transmission_secondaire_modele" maxlength="80" value="<%= a ? (a.transmission_secondaire_modele || '') : '' %>"></div>
        </fieldset>
      </div>
      <div class="grille-form">
        <div class="case"><input type="checkbox" id="al-secu-<%= b.id %>" name="securite_ligne" <%= a && a.securite_ligne ? 'checked' : '' %>><label for="al-secu-<%= b.id %>">Sécurité de ligne</label></div>
        <div class="case"><input type="checkbox" id="al-pers-<%= b.id %>" name="reponse_en_personne" <%= a && a.reponse_en_personne ? 'checked' : '' %>><label for="al-pers-<%= b.id %>">Réponse en personne aux alarmes</label></div>
        <div class="case"><input type="checkbox" id="al-entr-<%= b.id %>" name="contrat_entretien_annuel" <%= a && a.contrat_entretien_annuel ? 'checked' : '' %>><label for="al-entr-<%= b.id %>">Contrat annuel d’entretien</label></div>
        <div><label>Signaux d’ouverture/fermeture</label><select name="signaux_ouverture_fermeture"><option value="">—</option>
          <% LISTES_ALARME.signaux.forEach(([code, lib]) => { %><option value="<%= code %>" <%= a && a.signaux_ouverture_fermeture === code ? 'selected' : '' %>><%= lib %></option><% }) %>
        </select></div>
        <div><label>Dispositifs de périmètre</label><input type="text" name="dispositifs_perimetre" maxlength="200" value="<%= a ? (a.dispositifs_perimetre || '') : '' %>"></div>
      </div>
      <div class="grille-form">
        <fieldset><legend>Couverture de la détection de mouvements</legend>
          <% LISTES_ALARME.couvertures.forEach((t) => { %>
          <div class="case"><input type="checkbox" name="couverture_detection" value="<%= t %>" id="cd-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.couverture_detection) && a.couverture_detection.includes(t) ? 'checked' : '' %>><label for="cd-<%= b.id %>-<%= t %>"><%= t %></label></div>
          <% }) %>
        </fieldset>
        <fieldset><legend>Protection des coffres-forts</legend>
          <% LISTES_ALARME.coffres.forEach((t) => { %>
          <div class="case"><input type="checkbox" name="protection_coffres" value="<%= t %>" id="pc-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.protection_coffres) && a.protection_coffres.includes(t) ? 'checked' : '' %>><label for="pc-<%= b.id %>-<%= t %>"><%= t %></label></div>
          <% }) %>
        </fieldset>
        <fieldset><legend>Répondants aux alarmes</legend>
          <% LISTES_ALARME.repondants.forEach((t) => { %>
          <div class="case"><input type="checkbox" name="repondants" value="<%= t %>" id="rp-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.repondants) && a.repondants.includes(t) ? 'checked' : '' %>><label for="rp-<%= b.id %>-<%= t %>"><%= t %></label></div>
          <% }) %>
        </fieldset>
      </div>
      <div class="grille-form">
        <div class="case"><input type="checkbox" id="al-ulc-<%= b.id %>" name="certificat_ulc_actif" <%= a && a.certificat_ulc_actif ? 'checked' : '' %>><label for="al-ulc-<%= b.id %>">Certificat ULC actif</label></div>
        <div><label>N° de certificat ULC</label><input type="text" name="certificat_ulc_numero" maxlength="60" value="<%= a ? (a.certificat_ulc_numero || '') : '' %>"></div>
        <div><label>Expiration du certificat ULC</label><input type="date" name="certificat_ulc_expiration" value="<%= a ? (a.certificat_ulc_expiration || '') : '' %>"></div>
      </div>
      <fieldset><legend>Vidéosurveillance</legend><div class="grille-form">
        <% [['presente', 'Caméras présentes'], ['couvre_tout_sauf_toilettes', 'Couvre tout sauf les toilettes'], ['enregistre_24h', 'Enregistre 24 h/24'], ['sauvegardes_hors_site', 'Sauvegardes hors site'], ['exterieures', 'Caméras extérieures']].forEach(([k, lib]) => { %>
        <div class="case"><input type="checkbox" id="cam-<%= b.id %>-<%= k %>" name="camera_<%= k %>" <%= a && a.cameras_detail && a.cameras_detail[k] ? 'checked' : '' %>><label for="cam-<%= b.id %>-<%= k %>"><%= lib %></label></div>
        <% }) %>
      </div></fieldset>
      <fieldset><legend>Protections physiques</legend><div class="grille-form">
        <% LISTES_ALARME.physiques.forEach((t) => { %>
        <div class="case"><input type="checkbox" name="protections_physiques" value="<%= t %>" id="pp-<%= b.id %>-<%= t %>" <%= a && Array.isArray(a.protections_physiques) && a.protections_physiques.includes(t) ? 'checked' : '' %>><label for="pp-<%= b.id %>-<%= t %>"><%= t %></label></div>
        <% }) %>
      </div></fieldset>
      <fieldset><legend>Coffre-fort — détail</legend><div class="grille-form">
        <div><label>Fabricant</label><input type="text" name="coffre_fabricant" maxlength="80" value="<%= a && a.coffre_detail ? (a.coffre_detail.fabricant || '') : '' %>"></div>
        <div><label>Modèle</label><input type="text" name="coffre_modele" maxlength="80" value="<%= a && a.coffre_detail ? (a.coffre_detail.modele || '') : '' %>"></div>
        <div><label>Cote feu / cambriolage</label><input type="text" name="coffre_cote" maxlength="80" value="<%= a && a.coffre_detail ? (a.coffre_detail.cote || '') : '' %>"></div>
        <div class="case"><input type="checkbox" id="cf-poids-<%= b.id %>" name="coffre_poids" <%= a && a.coffre_detail && a.coffre_detail.poids_moins_500lb ? 'checked' : '' %>><label for="cf-poids-<%= b.id %>">Poids &lt; 500 lb</label></div>
        <div class="case"><input type="checkbox" id="cf-boul-<%= b.id %>" name="coffre_boulonne" <%= a && a.coffre_detail && a.coffre_detail.boulonne ? 'checked' : '' %>><label for="cf-boul-<%= b.id %>">Boulonné au sol</label></div>
        <div class="case"><input type="checkbox" id="cf-forte-<%= b.id %>" name="coffre_chambre_forte" <%= a && a.coffre_detail && a.coffre_detail.chambre_forte ? 'checked' : '' %>><label for="cf-forte-<%= b.id %>">Situé dans une chambre forte</label></div>
      </div></fieldset>
      <div class="actions"><button class="btn btn-petit" type="submit">Enregistrer le questionnaire alarme</button></div>
    </form>
  </details>
  <% }) %>
  <% if (!s.batiments.filter((b) => !b.archive).length) { %><p class="petit">Ajoutez d’abord un bâtiment.</p><% } %>
</div>

<div class="carte" id="beneficiaires">
  <div class="entete-page"><h2>👥 Bénéficiaires et créanciers (par emplacement)</h2></div>
  <p class="petit">Créanciers hypothécaires et autres bénéficiaires désignés pour chaque emplacement, avec leur clause de préavis de résiliation — section « Bénéficiaires » de la soumission combinée.</p>
  <% s.batiments.filter((b) => !b.archive).forEach((b) => { const liste = (typeof beneficiaires !== 'undefined' && beneficiaires[b.id]) || []; %>
  <details class="details-inline">
    <summary class="btn btn-secondaire btn-petit"><%= b.adresse %><%= b.ville ? ', ' + b.ville : '' %> — <%= liste.length %> bénéficiaire(s)</summary>
    <% if (liste.length) { %>
    <div class="tableau-deroulant"><table>
      <thead><tr><th>Nom</th><th>Adresse</th><th>Qualité</th><th>Préavis</th><th></th></tr></thead>
      <tbody>
      <% liste.forEach((ben) => { %>
        <tr><td><%= ben.nom %></td>
          <td><%= [ben.adresse, ben.ville, ben.code_postal].filter(Boolean).join(', ') || '—' %></td>
          <td><%= ben.qualite || '—' %></td><td><%= ben.clause_preavis || '—' %></td>
          <td><form method="post" action="/biens/beneficiaire/<%= ben.id %>/archiver" class="inline" data-confirm="Archiver ce bénéficiaire ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form></td></tr>
      <% }) %>
      </tbody>
    </table></div>
    <% } %>
    <form method="post" action="/biens/<%= s.id %>/batiment/<%= b.id %>/beneficiaire" class="grille-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label>Nom du bénéficiaire *</label><input type="text" name="nom" required maxlength="160"></div>
      <div><label>Adresse</label><input type="text" name="adresse" maxlength="200"></div>
      <div><label>Ville</label><input type="text" name="ville" maxlength="80"></div>
      <div><label>Code postal</label><input type="text" name="code_postal" maxlength="10"></div>
      <div><label>Qualité</label><input type="text" name="qualite" maxlength="120" placeholder="Créancier hypothécaire…"></div>
      <div><label>Clause de préavis</label><input type="text" name="clause_preavis" maxlength="80" placeholder="30 jours…"></div>
      <div class="actions"><button class="btn btn-petit" type="submit">+ Ajouter le bénéficiaire</button></div>
    </form>
  </details>
  <% }) %>
  <% if (!s.batiments.filter((b) => !b.archive).length) { %><p class="petit">Ajoutez d’abord un bâtiment.</p><% } %>
</div>

<div class="carte" id="contenus">
  <div class="entete-page"><h2>📦 Contenus (<%= s.contenus_generaux.length + s.batiments.reduce((n, b) => n + (b.contenus || []).filter((c) => !c.archive).length, 0) %>)</h2>
    <div><button type="button" class="btn btn-petit" data-toggle-cible="form-contenu">+ Ajouter un contenu</button></div></div>

  <div id="form-contenu" hidden>
    <form method="post" action="/biens/<%= s.id %>/contenu" class="grille-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label>Description *</label><input type="text" name="description" required maxlength="200"></div>
      <div><label>Type</label><select name="type_contenu"><option value="">—</option>
        <% TYPES_CONTENU.forEach((t) => { %><option value="<%= t %>"><%= NOMS_TYPE_CONTENU[t] %></option><% }) %>
      </select></div>
      <div><label>Valeur ($)</label><input type="number" name="valeur" min="0" step="0.01"></div>
      <div><label>Bâtiment concerné</label><select name="batiment_id"><option value="">— Général (soumission) —</option>
        <% s.batiments.filter((b) => !b.archive).forEach((b) => { %><option value="<%= b.id %>"><%= b.adresse %></option><% }) %>
      </select></div>
      <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"></textarea></div>
      <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Ajouter ce contenu</button></div>
    </form>
  </div>

  <% const tousContenus = [...s.contenus_generaux, ...s.batiments.flatMap((b) => (b.contenus || []).map((c) => ({ ...c, batiment_adresse: b.adresse })))].filter((c) => !c.archive); %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Description</th><th>Type</th><th>Valeur</th><th>Bâtiment</th><th></th></tr></thead>
    <tbody>
    <% tousContenus.forEach((c) => { %>
      <tr>
        <td><strong><%= c.description %></strong></td>
        <td><%= c.type_contenu ? NOMS_TYPE_CONTENU[c.type_contenu] : '—' %></td>
        <td><%= c.valeur !== null && c.valeur !== undefined ? Number(c.valeur).toLocaleString('fr-CA') + ' $' : '—' %></td>
        <td><%= c.batiment_adresse || 'Général' %></td>
        <td style="white-space:nowrap">
          <button type="button" class="btn btn-petit btn-secondaire" data-toggle-cible="modif-contenu-<%= c.id %>">Modifier</button>
          <form method="post" action="/biens/contenu/<%= c.id %>/archiver" class="inline" data-confirm="Archiver ce contenu ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form>
        </td>
      </tr>
      <tr id="modif-contenu-<%= c.id %>" hidden><td colspan="5">
        <form method="post" action="/biens/contenu/<%= c.id %>" class="grille-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>Description *</label><input type="text" name="description" required maxlength="200" value="<%= c.description || '' %>"></div>
          <div><label>Type</label><select name="type_contenu"><option value="">—</option>
            <% TYPES_CONTENU.forEach((t) => { %><option value="<%= t %>"<%= c.type_contenu === t ? ' selected' : '' %>><%= NOMS_TYPE_CONTENU[t] %></option><% }) %>
          </select></div>
          <div><label>Valeur ($)</label><input type="number" name="valeur" min="0" step="0.01" value="<%= c.valeur !== null && c.valeur !== undefined ? c.valeur : '' %>"></div>
          <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"><%= c.notes || '' %></textarea></div>
          <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Enregistrer</button></div>
        </form>
      </td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (!tousContenus.length) { %><p class="petit">Aucun contenu pour l’instant.</p><% } %>
  <% const contArch = [...s.contenus_generaux, ...s.batiments.flatMap((b) => b.contenus || [])].filter((c) => c.archive); %>
  <% if (contArch.length) { %><p class="petit">Archivés : <% contArch.forEach((c, i) => { %><%= i ? ', ' : '' %><%= c.description %> <form method="post" action="/biens/contenu/<%= c.id %>/desarchiver" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="lien" type="submit">restaurer</button></form><% }) %></p><% } %>
</div>

<div class="carte" id="garanties">
  <h2>🛡️ Garanties par bâtiment</h2>
  <% if (!s.batiments.filter((b) => !b.archive).length) { %><p class="petit">Ajoutez d’abord un bâtiment.</p><% } %>
  <% s.batiments.filter((b) => !b.archive).forEach((b) => { const g = b.garanties; %>
  <h3><%= b.adresse %></h3>
  <% if (g) { %><p class="petit">Actuel : <%= g.formule ? NOMS_FORMULE[g.formule] : '—' %> · montant <%= g.montant_assurance ? Number(g.montant_assurance).toLocaleString('fr-CA') + ' $' : '—' %> · franchise <%= g.franchise ? Number(g.franchise).toLocaleString('fr-CA') + ' $' : '—' %></p><% } %>
  <form method="post" action="/biens/<%= s.id %>/batiment/<%= b.id %>/garanties" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="form-<%= b.id %>">Formule</label>
      <select id="form-<%= b.id %>" name="formule">
        <option value="">—</option>
        <% FORMULES.forEach((f) => { %><option value="<%= f %>"<%= g && g.formule === f ? ' selected' : '' %>><%= NOMS_FORMULE[f] %></option><% }) %>
      </select></div>
    <div><label for="mont-<%= b.id %>">Montant d’assurance ($)</label>
      <input type="number" id="mont-<%= b.id %>" name="montant_assurance" min="0" step="0.01" value="<%= g && g.montant_assurance !== null ? g.montant_assurance : '' %>"></div>
    <div><label for="fr-<%= b.id %>">Franchise ($)</label>
      <input type="number" id="fr-<%= b.id %>" name="franchise" min="0" step="0.01" value="<%= g && g.franchise !== null ? g.franchise : '' %>"></div>
    <div><label for="prime-<%= b.id %>">Prime ($, si connue)</label>
      <input type="number" id="prime-<%= b.id %>" name="prime" min="0" step="0.01" value="<%= g && g.prime !== null ? g.prime : '' %>"></div>
    <div><label for="rp-<%= b.id %>">Règle proportionnelle — bâtiment (%)</label>
      <input type="number" id="rp-<%= b.id %>" name="regle_proportionnelle" min="0" max="100" step="0.01" value="<%= g && g.regle_proportionnelle != null ? g.regle_proportionnelle : '' %>"></div>
    <div><label for="frc-<%= b.id %>">Franchise — contenu ($)</label>
      <input type="number" id="frc-<%= b.id %>" name="franchise_contenu" min="0" step="0.01" value="<%= g && g.franchise_contenu != null ? g.franchise_contenu : '' %>"></div>
    <div><label for="rpc-<%= b.id %>">Règle proportionnelle — contenu (%)</label>
      <input type="number" id="rpc-<%= b.id %>" name="regle_proportionnelle_contenu" min="0" max="100" step="0.01" value="<%= g && g.regle_proportionnelle_contenu != null ? g.regle_proportionnelle_contenu : '' %>"></div>
    <div style="grid-column:1/-1"><span class="petit"><strong>Section Crime</strong> — limites par risque ($)</span></div>
    <% const crimeG = (g && g.crime) || {}; %>
    <div><label>Détournements par les employés</label>
      <input type="number" name="crime_detournements" min="0" step="0.01" value="<%= crimeG.detournements_employes != null ? crimeG.detournements_employes : '' %>"></div>
    <div><label>Vol et effraction</label>
      <input type="number" name="crime_vol_effraction" min="0" step="0.01" value="<%= crimeG.vol_effraction != null ? crimeG.vol_effraction : '' %>"></div>
    <div><label>Contrefaçon de billets de banque</label>
      <input type="number" name="crime_contrefacon_billets" min="0" step="0.01" value="<%= crimeG.contrefacon_billets != null ? crimeG.contrefacon_billets : '' %>"></div>
    <div><label>Contrefaçon de cartes</label>
      <input type="number" name="crime_contrefacon_cartes" min="0" step="0.01" value="<%= crimeG.contrefacon_cartes != null ? crimeG.contrefacon_cartes : '' %>"></div>
    <div><label>Destruction d’argent et de titres</label>
      <input type="number" name="crime_destruction" min="0" step="0.01" value="<%= crimeG.destruction_argent_titres != null ? crimeG.destruction_argent_titres : '' %>"></div>
    <div><label>Argent dans un coffre-fort</label>
      <input type="number" name="crime_coffre_fort" min="0" step="0.01" value="<%= crimeG.coffre_fort_argent != null ? crimeG.coffre_fort_argent : '' %>"></div>
    <div><label>Comptes clients — montant ($)</label>
      <input type="number" name="comptes_clients_montant" min="0" step="0.01" value="<%= g && g.comptes_clients_montant != null ? g.comptes_clients_montant : '' %>"></div>
    <div><label>Chantier / risque de constructeur — montant ($)</label>
      <input type="number" name="chantier_montant" min="0" step="0.01" value="<%= g && g.chantier_montant != null ? g.chantier_montant : '' %>"></div>
    <div style="grid-column:1/-1"><span class="petit">Avenants</span><br>
      <% AVENANTS_BIENS.forEach(([code, libelle], i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="av-<%= b.id %>-<%= i %>" name="avenants" value="<%= code %>"<%= g && g.avenants && g.avenants[code] ? ' checked' : '' %>><label for="av-<%= b.id %>-<%= i %>"><%= libelle %></label></span>
      <% }) %></div>
    <div style="grid-column:1/-1">
      <details class="details-inline">
        <summary class="btn btn-secondaire btn-petit">Avenants détaillés — franchise et montant par avenant</summary>
        <div class="tableau-deroulant"><table>
          <thead><tr><th>Avenant</th><th>Franchise ($)</th><th>Montant ($)</th><th>Détails</th></tr></thead>
          <tbody>
          <% AVENANTS_DETAILLES.forEach(([code, libelle]) => { const av = g && g.avenants ? g.avenants[code] : null; const det = av && typeof av === 'object' ? av : {}; %>
            <tr>
              <td><span class="case" style="display:inline-flex"><input type="checkbox" id="avd-<%= b.id %>-<%= code %>" name="avenant_det_<%= code %>"<%= av ? ' checked' : '' %>><label for="avd-<%= b.id %>-<%= code %>"><%= libelle %></label></span></td>
              <td><input type="number" name="avenant_det_<%= code %>_franchise" min="0" step="0.01" value="<%= det.franchise != null ? det.franchise : '' %>"></td>
              <td><input type="number" name="avenant_det_<%= code %>_montant" min="0" step="0.01" value="<%= det.montant != null ? det.montant : '' %>"></td>
              <td>
                <% (CHAMPS_AVENANT_SUPPL[code] || []).forEach((champ) => { %>
                <label class="petit"><%= ({franchise_pct: 'Franchise (%)', franchise_min: 'Franchise min. ($)', date_debut: 'Du', date_fin: 'Au', montant_hors_lieux: 'Montant hors lieux ($)', montant_par_accident: 'Montant par accident ($)', limitations: 'Limitations'})[champ] || champ %>
                <input type="<%= champ.startsWith('date') ? 'date' : (champ === 'limitations' ? 'text' : 'number') %>" name="avenant_det_<%= code %>_<%= champ %>" <%= champ === 'limitations' ? '' : 'min="0" step="0.01"' %> value="<%= det[champ] != null ? det[champ] : '' %>"></label>
                <% }) %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table></div>
      </details>
    </div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les garanties</button></div>
  </form>
  <% }) %>
</div>

<div class="carte" id="flottante">
  <h2>🧰 Assurance flottante des outils</h2>
  <p class="petit">Liste des articles couverts par la flottante (annexe de la soumission combinée). Laissez vide si la garantie ne s’applique pas.</p>
  <% const articles = (typeof flottante !== 'undefined' && flottante) || []; %>
  <% if (articles.length) { %>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Description</th><th>Base de règlement</th><th>Assuré additionnel</th><th>Montant ($)</th><th></th></tr></thead>
    <tbody>
    <% articles.forEach((art) => { %>
      <tr><td><%= art.description %></td><td><%= art.base_reglement || '—' %></td><td><%= art.assure_additionnel || '—' %></td>
        <td><%= art.montant != null ? Number(art.montant).toLocaleString('fr-CA') : '—' %></td>
        <td><form method="post" action="/biens/flottante/<%= art.id %>/archiver" class="inline" data-confirm="Archiver cet article ?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
  <form method="post" action="/biens/<%= s.id %>/flottante" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label>Description de l’article *</label><input type="text" name="description" required maxlength="200"></div>
    <div><label>Base de règlement</label><input type="text" name="base_reglement" maxlength="120" placeholder="Valeur à neuf…"></div>
    <div><label>Assuré additionnel</label><input type="text" name="assure_additionnel" maxlength="120"></div>
    <div><label>Montant ($)</label><input type="number" name="montant" min="0" step="0.01"></div>
    <div class="actions"><button class="btn btn-petit" type="submit">+ Ajouter l’article</button></div>
  </form>
</div>

<div class="carte" id="antecedents">
  <h2>📋 Antécédents d’assurance</h2>
  <% const a = s.antecedents; %>
  <form method="post" action="/biens/<%= s.id %>/antecedents" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="ass-actuel">Assureur actuel</label>
      <input type="text" id="ass-actuel" name="assureur_actuel" maxlength="120" value="<%= a && a.assureur_actuel ? a.assureur_actuel : '' %>"></div>
    <div><label for="pol-actuelle">N° de police actuelle</label>
      <input type="text" id="pol-actuelle" name="numero_police_actuelle" maxlength="60" value="<%= a && a.numero_police_actuelle ? a.numero_police_actuelle : '' %>"></div>
    <div><label for="exp-actuelle">Expiration</label>
      <input type="date" id="exp-actuelle" name="date_expiration_actuelle" value="<%= a && a.date_expiration_actuelle ? a.date_expiration_actuelle : '' %>"></div>
    <div><label for="annees-cont">Années d’assurance continue</label>
      <input type="number" id="annees-cont" name="annees_assurance_continue" min="0" max="80" value="<%= a && a.annees_assurance_continue !== null && a.annees_assurance_continue !== undefined ? a.annees_assurance_continue : '' %>"></div>
    <div style="grid-column:1/-1">
      <span class="petit">Sinistres des 5 dernières années (date, type, montant $)</span>
      <div data-lignes-dynamiques data-existant='<%= a && a.sinistres_5ans ? JSON.stringify(a.sinistres_5ans).replace(/'/g, "&#39;") : "[]" %>'>
        <div class="lignes"></div>
        <template><div class="ligne-dynamique" style="display:flex;gap:8px;margin:6px 0">
          <input data-col="date" type="date" aria-label="Date">
          <input data-col="type" type="text" placeholder="Type" maxlength="120">
          <input data-col="montant" type="number" min="0" step="0.01" placeholder="Montant $" style="width:120px">
          <button type="button" class="btn btn-petit btn-secondaire retirer-ligne">✕</button>
        </div></template>
        <button type="button" class="btn btn-petit btn-secondaire ajouter-ligne">+ Ajouter un sinistre</button>
        <input type="hidden" name="sinistres_json" value="[]">
      </div>
    </div>
    <div style="grid-column:1/-1"><span class="petit">Consentements</span><br>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="cons-credit" name="consentement_credit"<%= a && a.consentements && a.consentements.credit ? ' checked' : '' %>><label for="cons-credit">Dossier de crédit</label></span>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="cons-ass" name="consentement_dossier_assurance"<%= a && a.consentements && a.consentements.dossier_assurance ? ' checked' : '' %>><label for="cons-ass">Dossier d’assurance (sinistres antérieurs)</label></span>
    </div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les antécédents</button></div>
  </form>
</div>

<div class="carte" id="versions">
  <h2>🕘 Historique des versions</h2>
  <p class="petit">Chaque enregistrement fige une version : rien n’est jamais modifié ni effacé.</p>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Version</th><th>Statut</th><th>Créée le</th><th>Par</th><th></th></tr></thead>
    <tbody>
    <% versions.forEach((v) => { %>
      <tr>
        <td><strong>v<%= v.version %></strong></td>
        <td><%= NOMS_STATUTS_SOUMISSION[v.statut] || v.statut %></td>
        <td><%= (v.cree_le || '').slice(0, 16).replace('T', ' ') %></td>
        <td><%= v.auteur || '—' %></td>
        <td><a class="btn btn-petit btn-secondaire" href="/biens/<%= s.id %>/versions/<%= v.version %>">Voir</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/bas') %>
