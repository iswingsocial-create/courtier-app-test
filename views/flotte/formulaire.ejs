<%- include('../partials/haut', { titre: 'Nouvelle soumission flotte' }) %>
<div class="entete-page">
  <h1>🚛 Nouvelle soumission flotte</h1>
  <div><a class="btn btn-secondaire btn-petit" href="/flotte">← Soumissions</a></div>
</div>

<% if (erreur) { %><div class="alerte alerte-erreur"><%= erreur %></div><% } %>

<div class="carte">
  <form method="post" action="/flotte" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="client_id">Entreprise cliente *</label>
      <select id="client_id" name="client_id" required>
        <option value="">— Choisir —</option>
        <% entreprises.forEach((e) => { %>
          <option value="<%= e.id %>"<%= String(valeurs.client_id || '') === String(e.id) ? ' selected' : '' %>><%= e.raison_sociale %></option>
        <% }) %>
      </select></div>
    <div><label for="assureur">Assureur (si connu)</label>
      <input type="text" id="assureur" name="assureur" maxlength="120" value="<%= valeurs.assureur || '' %>"></div>
    <div><label for="nb_vehicules">Nombre de véhicules déclarés</label>
      <input type="number" id="nb_vehicules" name="nb_vehicules" min="0" step="1" value="<%= valeurs.nb_vehicules || '' %>"></div>
    <div><label for="rayon_operation_km">Rayon d’opération principal (km)</label>
      <input type="number" id="rayon_operation_km" name="rayon_operation_km" min="0" step="1" value="<%= valeurs.rayon_operation_km || '' %>"></div>
    <div><label for="usage_dominant">Usage dominant</label>
      <select id="usage_dominant" name="usage_dominant">
        <option value="">— Choisir —</option>
        <% Object.keys(NOMS_USAGES_DOMINANTS).forEach((k) => { %>
          <option value="<%= k %>"<%= valeurs.usage_dominant === k ? ' selected' : '' %>><%= NOMS_USAGES_DOMINANTS[k] %></option>
        <% }) %>
      </select></div>
    <div><label for="date_effet_souhaitee">Date d’effet souhaitée</label>
      <input type="date" id="date_effet_souhaitee" name="date_effet_souhaitee" value="<%= valeurs.date_effet_souhaitee || '' %>"></div>
    <div><label for="date_echeance_visee">Date d’échéance visée</label>
      <input type="date" id="date_echeance_visee" name="date_echeance_visee" value="<%= valeurs.date_echeance_visee || '' %>"></div>
    <div style="grid-column:1/-1"><label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="3"><%= valeurs.notes || '' %></textarea></div>
    <div class="actions" style="grid-column:1/-1"><button class="btn" type="submit">Créer la soumission</button></div>
  </form>
  <p class="petit">Les véhicules, conducteurs, garanties et antécédents s’ajoutent ensuite sur la fiche, en nombre illimité.</p>
</div>
<%- include('../partials/bas') %>
