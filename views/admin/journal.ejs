<%- include('../partials/haut', { titre: 'Journal d’audit' }) %>
<div class="entete-page">
  <h1>🧾 Journal d’audit</h1>
  <a class="btn btn-secondaire btn-petit" href="/admin/utilisateurs">← Utilisateurs</a>
</div>

<div class="carte">
  <form method="get" action="/admin/journal" class="grille-form">
    <div><label for="utilisateur">Utilisateur</label>
      <select id="utilisateur" name="utilisateur" data-autosubmit>
        <option value="">Tous</option>
        <% utilisateurs.forEach((u) => { %>
          <option value="<%= u.id %>" <%= filtreUser === u.id ? 'selected' : '' %>><%= u.nom %></option>
        <% }) %>
      </select></div>
    <div><label for="action">Action</label>
      <select id="action" name="action" data-autosubmit>
        <option value="">Toutes</option>
        <% actions.forEach((a) => { %>
          <option value="<%= a.action %>" <%= filtreAction === a.action ? 'selected' : '' %>><%= a.action %></option>
        <% }) %>
      </select></div>
  </form>
</div>

<div class="carte"><div class="tableau-deroulant"><table>
  <thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Détails</th></tr></thead>
  <tbody>
  <% lignes.forEach((l) => { %>
    <tr>
      <td class="petit"><%= l.cree_le.slice(0, 16).replace('T', ' ') %></td>
      <td><%= l.utilisateur_nom || '—' %><br><span class="petit"><%= l.utilisateur_email || '' %></span></td>
      <td><span class="badge badge-gris"><%= l.action %></span></td>
      <td><%= l.details || '—' %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% if (!lignes.length) { %><p class="petit">Aucune entrée.</p><% } %>
<% if (pages > 1) { %>
<p class="petit">Page <%= page %> / <%= pages %> (<%= total %> entrées)
  <% if (page > 1) { %><a class="btn btn-petit btn-secondaire" href="/admin/journal?page=<%= page - 1 %><%= filtreUser ? '&utilisateur=' + filtreUser : '' %><%= filtreAction ? '&action=' + encodeURIComponent(filtreAction) : '' %>">← Précédente</a><% } %>
  <% if (page < pages) { %><a class="btn btn-petit btn-secondaire" href="/admin/journal?page=<%= page + 1 %><%= filtreUser ? '&utilisateur=' + filtreUser : '' %><%= filtreAction ? '&action=' + encodeURIComponent(filtreAction) : '' %>">Suivante →</a><% } %>
</p>
<% } %>
</div>
<%- include('../partials/bas') %>
