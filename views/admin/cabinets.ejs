<%- include('../partials/haut', { titre: 'Cabinets' }) %>
<div class="entete-page">
  <h1>🏢 Cabinets</h1>
  <div>
    <a class="btn btn-secondaire btn-petit" href="/admin/microsoft">Microsoft 365 / Teams →</a>
    <a class="btn btn-secondaire btn-petit" href="/admin/cohere">🔑 Clé IA (Cohere) →</a>
    <a class="btn btn-secondaire btn-petit" href="/admin/utilisateurs">Utilisateurs →</a>
  </div>
</div>

<div class="carte">
  <h3>Créer un cabinet</h3>
  <form method="post" action="/admin/cabinets" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="nom">Nom du cabinet</label><input type="text" id="nom" name="nom" required maxlength="120"></div>
    <div class="actions" style="margin-top:0; align-self:end"><button class="btn btn-petit" type="submit">Créer</button></div>
  </form>
</div>

<div class="carte"><div class="tableau-deroulant"><table>
  <thead><tr><th>Nom</th><th>Utilisateurs</th><th>Clients</th><th>Lien de capture leads</th><th>Créé le</th></tr></thead>
  <tbody>
  <% cabinets.forEach((c) => { %>
    <tr>
      <td><%= c.nom %></td>
      <td><%= c.nb_users %></td>
      <td><%= c.nb_clients %></td>
      <td>
        <span class="bloc-code petit">/capture/<%= c.token_capture %></span>
        <form method="post" action="/admin/cabinets/<%= c.id %>/token-capture" class="inline" data-confirm="Régénérer le lien ? L'ancien lien cessera de fonctionner.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-petit btn-secondaire" type="submit" title="Régénérer">↻</button>
        </form>
      </td>
      <td><%= c.cree_le.slice(0, 10) %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<p class="petit">Le lien de capture est le formulaire public à mettre dans vos publicités. Préfixez-le de l'adresse du serveur (ex. : https://votre-serveur/capture/…). Seul l'admin de ce panneau peut le voir et le régénérer.</p>
</div>

<div class="carte">
  <h3>✉️ En-tête d’envoi (propositions et demandes de prix)</h3>
  <p class="petit">Les coordonnées du cabinet imprimées en en-tête des propositions — notamment la proposition combinée (demande de prix aux assureurs). Un formulaire par cabinet.</p>
  <% cabinets.forEach((c) => { %>
  <details class="details-inline">
    <summary class="btn btn-secondaire btn-petit"><%= c.nom %></summary>
    <form method="post" action="/admin/cabinets/<%= c.id %>/entete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grille-form">
        <div><label>Adresse</label><input type="text" name="adresse" value="<%= c.adresse || '' %>"></div>
        <div><label>Ville</label><input type="text" name="ville" value="<%= c.ville || '' %>"></div>
        <div><label>Code postal</label><input type="text" name="code_postal" value="<%= c.code_postal || '' %>"></div>
        <div><label>Téléphone</label><input type="text" name="telephone" value="<%= c.telephone || '' %>"></div>
        <div><label>Télécopieur</label><input type="text" name="telecopieur" value="<%= c.telecopieur || '' %>"></div>
        <div><label>Site Web</label><input type="text" name="site_web" value="<%= c.site_web || '' %>"></div>
        <div><label>Courriel</label><input type="email" name="courriel" value="<%= c.courriel || '' %>"></div>
      </div>
      <button class="btn btn-petit" type="submit">Enregistrer l'en-tête</button>
    </form>
  </details>
  <% }) %>
</div>
<%- include('../partials/bas') %>
