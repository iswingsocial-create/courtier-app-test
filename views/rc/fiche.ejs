<%- include('../partials/haut', { titre: 'Soumission RC #' + s.id }) %>
<div class="entete-page">
  <h1>⚖️ Soumission RC #<%= s.id %></h1>
  <div>
    <span class="badge <%= s.statut === 'convertie_police' ? 'badge-ok' : (s.statut === 'soumise' ? 'badge-j' : 'badge-gris') %>"><%= NOMS_STATUTS_SOUMISSION[s.statut] %></span>
    <a class="btn btn-secondaire btn-petit" href="/rc">← Soumissions</a>
  </div>

</div>
<%- include('../partials/manques', { sectionDemandes }) %>
<%- include('../partials/mise-en-marche', { sectionMarche }) %>


<div class="carte">
  <dl class="dl">
    <dt>Entreprise</dt><dd><strong><%= clientNom %></strong></dd>
    <dt>Date d’effet souhaitée</dt><dd><%= s.date_effet_souhaitee || '—' %></dd>
    <dt>Notes</dt><dd><%= s.notes || '—' %></dd>
    <dt>Créée le</dt><dd><%= (s.cree_le || '').slice(0, 16).replace('T', ' ') %></dd>
  </dl>
  <div class="actions">
    <% Object.keys(NOMS_STATUTS_SOUMISSION).filter((k) => k !== s.statut).forEach((k) => { %>
    <form method="post" action="/rc/<%= s.id %>/statut" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="statut" value="<%= k %>">
      <button class="btn btn-petit btn-secondaire" type="submit">→ <%= NOMS_STATUTS_SOUMISSION[k] %></button>
    </form>
    <% }) %>
    <form method="post" action="/rc/<%= s.id %>/<%= s.archive ? 'desarchiver' : 'archiver' %>" class="inline" data-confirm="<%= s.archive ? 'Désarchiver cette soumission ?' : 'Archiver cette soumission ?' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-petit btn-secondaire" type="submit"><%= s.archive ? 'Désarchiver' : 'Archiver' %></button>
    </form>
    <a class="btn btn-petit" href="/rc/<%= s.id %>/proposition">📄 Proposition</a>
  </div>
</div>

<% if (policeLiee) { %>
<div class="carte">
  <h3>🏛️ Police liée</h3>
  <p>Cette soumission est convertie en <strong>police <%= policeLiee.numero_police %></strong>
    (<%= policeLiee.assureur %>, effet <%= policeLiee.date_effet %> → échéance <%= policeLiee.date_echeance %>).</p>
  <div class="actions"><a class="btn btn-petit" href="/echeances/police/<%= policeLiee.id %>">Ouvrir la fiche de gestion</a></div>
</div>
<% } else if (s.statut !== 'convertie_police') { %>
<div class="carte" id="conversion">
  <h3>🏛️ Convertir en police</h3>
  <p class="petit">Crée la police RC (CGL) à gérer : les données de la soumission sont figées en référence, puis chaque avenant en cours de terme créera une nouvelle version de la police.</p>
  <form method="post" action="/rc/<%= s.id %>/convertir" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="numero_police">Numéro de police *</label><input type="text" id="numero_police" name="numero_police" required maxlength="60"></div>
    <div><label for="assureur_id">Assureur *</label>
      <select id="assureur_id" name="assureur_id" required>
        <option value="">— Choisir —</option>
        <% assureurs.forEach((a) => { %><option value="<%= a.id %>"><%= a.nom %></option><% }) %>
      </select></div>
    <div><label for="date_effet">Date d’effet *</label><input type="date" id="date_effet" name="date_effet" required value="<%= s.date_effet_souhaitee || '' %>"></div>
    <div><label for="date_echeance">Date d’échéance *</label><input type="date" id="date_echeance" name="date_echeance" required></div>
    <div><label for="franchise">Franchise ($)</label><input type="number" id="franchise" name="franchise" step="0.01" min="0" value="0"></div>
    <div class="actions"><button class="btn" type="submit">Convertir en police</button></div>
  </form>
  <% if (policesDispo.length) { %>
  <h4>Ou lier une police existante</h4>
  <form method="post" action="/rc/<%= s.id %>/lier-police" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="police_id">Police RC de <%= clientNom %></label>
      <select id="police_id" name="police_id" required>
        <% policesDispo.forEach((p) => { %><option value="<%= p.id %>"><%= p.numero_police %></option><% }) %>
      </select></div>
    <div class="actions"><button class="btn btn-secondaire" type="submit">Lier cette police</button></div>
  </form>
  <% } %>
</div>
<% } %>

<div class="carte" id="exploitations">
  <div class="entete-page"><h2>🏭 Lieux d’exploitation (<%= s.exploitations.filter((e) => !e.archive).length %>)</h2>
    <div><button type="button" class="btn btn-petit" data-toggle-cible="form-exploitation">+ Ajouter un lieu</button></div></div>

  <div id="form-exploitation" hidden>
    <form method="post" action="/rc/<%= s.id %>/exploitation" class="grille-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label>Adresse *</label><input type="text" name="adresse" required maxlength="200"></div>
      <div><label>Ville</label><input type="text" name="ville" maxlength="100"></div>
      <div><label>Code postal</label><input type="text" name="code_postal" maxlength="12"></div>
      <div><label>Type d’activité</label><input type="text" name="type_activite" maxlength="120" placeholder="Rénovation résidentielle, déneigement…"></div>
      <div><label>Code de classification</label><input type="text" name="code_classification" maxlength="40" placeholder="Code de l’assureur"></div>
      <div style="grid-column:1/-1"><label>Description des activités</label><textarea name="description_activites" rows="2" placeholder="Description détaillée pour le souscripteur"></textarea></div>
      <div><label>Chiffre d’affaires ($)</label><input type="number" name="chiffre_affaires" min="0" step="0.01"></div>
      <div><label>Masse salariale ($)</label><input type="number" name="masse_salariale" min="0" step="0.01"></div>
      <div><label>Nombre d’employés</label><input type="number" name="nb_employes" min="0"></div>
      <div><label>Superficie (pi²)</label><input type="number" name="superficie_pi2" min="0" step="0.01"></div>
      <div><label>Sous-traitants</label><select name="sous_traitants"><option value="">—</option>
        <% SOUS_TRAITANTS.forEach((t) => { %><option value="<%= t %>"><%= NOMS_SOUS_TRAITANT[t] %></option><% }) %>
      </select></div>
      <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"></textarea></div>
      <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Ajouter ce lieu</button></div>
    </form>
  </div>

  <div class="tableau-deroulant"><table>
    <thead><tr><th>Adresse</th><th>Type d’activité</th><th>Chiffre d’affaires</th><th>Employés</th><th>Sous-traitants</th><th></th></tr></thead>
    <tbody>
    <% s.exploitations.filter((e) => !e.archive).forEach((e) => { %>
      <tr>
        <td><strong><%= e.adresse %></strong><br><span class="petit"><%= [e.ville, e.code_postal].filter(Boolean).join(', ') %></span></td>
        <td><%= e.type_activite || '—' %></td>
        <td><%= e.chiffre_affaires ? Number(e.chiffre_affaires).toLocaleString('fr-CA') + ' $' : '—' %></td>
        <td><%= e.nb_employes !== null && e.nb_employes !== undefined ? e.nb_employes : '—' %></td>
        <td><%= e.sous_traitants ? NOMS_SOUS_TRAITANT[e.sous_traitants] : '—' %></td>
        <td style="white-space:nowrap">
          <button type="button" class="btn btn-petit btn-secondaire" data-toggle-cible="modif-exploitation-<%= e.id %>">Modifier</button>
          <form method="post" action="/rc/exploitation/<%= e.id %>/archiver" class="inline" data-confirm="Archiver ce lieu d’exploitation ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-petit btn-secondaire" type="submit">Archiver</button></form>
        </td>
      </tr>
      <tr id="modif-exploitation-<%= e.id %>" hidden><td colspan="6">
        <form method="post" action="/rc/exploitation/<%= e.id %>" class="grille-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>Adresse *</label><input type="text" name="adresse" required maxlength="200" value="<%= e.adresse || '' %>"></div>
          <div><label>Ville</label><input type="text" name="ville" maxlength="100" value="<%= e.ville || '' %>"></div>
          <div><label>Code postal</label><input type="text" name="code_postal" maxlength="12" value="<%= e.code_postal || '' %>"></div>
          <div><label>Type d’activité</label><input type="text" name="type_activite" maxlength="120" value="<%= e.type_activite || '' %>"></div>
          <div><label>Code de classification</label><input type="text" name="code_classification" maxlength="40" value="<%= e.code_classification || '' %>"></div>
          <div style="grid-column:1/-1"><label>Description des activités</label><textarea name="description_activites" rows="2"><%= e.description_activites || '' %></textarea></div>
          <div><label>Chiffre d’affaires ($)</label><input type="number" name="chiffre_affaires" min="0" step="0.01" value="<%= e.chiffre_affaires !== null && e.chiffre_affaires !== undefined ? e.chiffre_affaires : '' %>"></div>
          <div><label>Masse salariale ($)</label><input type="number" name="masse_salariale" min="0" step="0.01" value="<%= e.masse_salariale !== null && e.masse_salariale !== undefined ? e.masse_salariale : '' %>"></div>
          <div><label>Nombre d’employés</label><input type="number" name="nb_employes" min="0" value="<%= e.nb_employes !== null && e.nb_employes !== undefined ? e.nb_employes : '' %>"></div>
          <div><label>Superficie (pi²)</label><input type="number" name="superficie_pi2" min="0" step="0.01" value="<%= e.superficie_pi2 !== null && e.superficie_pi2 !== undefined ? e.superficie_pi2 : '' %>"></div>
          <div><label>Sous-traitants</label><select name="sous_traitants"><option value="">—</option>
            <% SOUS_TRAITANTS.forEach((t) => { %><option value="<%= t %>"<%= e.sous_traitants === t ? ' selected' : '' %>><%= NOMS_SOUS_TRAITANT[t] %></option><% }) %>
          </select></div>
          <div style="grid-column:1/-1"><label>Notes</label><textarea name="notes" rows="2"><%= e.notes || '' %></textarea></div>
          <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit" type="submit">Enregistrer</button></div>
        </form>
      </td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (!s.exploitations.filter((e) => !e.archive).length) { %><p class="petit">Aucun lieu d’exploitation pour l’instant.</p><% } %>
  <% const expArch = s.exploitations.filter((e) => e.archive); %>
  <% if (expArch.length) { %><p class="petit">Archivés : <% expArch.forEach((e, i) => { %><%= i ? ', ' : '' %><%= e.adresse %> <form method="post" action="/rc/exploitation/<%= e.id %>/desarchiver" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="lien" type="submit">restaurer</button></form><% }) %></p><% } %>
</div>

<div class="carte" id="garanties">
  <h2>🛡️ Garanties par lieu d’exploitation</h2>
  <% if (!s.exploitations.filter((e) => !e.archive).length) { %><p class="petit">Ajoutez d’abord un lieu d’exploitation.</p><% } %>
  <% s.exploitations.filter((e) => !e.archive).forEach((e) => { const g = e.garanties; %>
  <h3><%= e.adresse %><%= e.type_activite ? ' — ' + e.type_activite : '' %></h3>
  <% if (g) { %><p class="petit">Actuel : <%= g.formule ? NOMS_FORMULE_RC[g.formule] : '—' %> · limite/sinistre <%= g.limite_par_sinistre ? Number(g.limite_par_sinistre).toLocaleString('fr-CA') + ' $' : '—' %> · agrégat <%= g.limite_agregat ? Number(g.limite_agregat).toLocaleString('fr-CA') + ' $' : '—' %> · franchise <%= g.franchise ? Number(g.franchise).toLocaleString('fr-CA') + ' $' : '—' %></p><% } %>
  <form method="post" action="/rc/<%= s.id %>/exploitation/<%= e.id %>/garanties" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="formule-<%= e.id %>">Formule</label>
      <select id="formule-<%= e.id %>" name="formule">
        <option value="">—</option>
        <% FORMULES_RC.forEach((f) => { %><option value="<%= f %>"<%= g && g.formule === f ? ' selected' : '' %>><%= NOMS_FORMULE_RC[f] %></option><% }) %>
      </select></div>
    <div><label for="lim-sin-<%= e.id %>">Limite par sinistre ($)</label>
      <input type="number" id="lim-sin-<%= e.id %>" name="limite_par_sinistre" min="0" step="0.01" value="<%= g && g.limite_par_sinistre !== null ? g.limite_par_sinistre : '' %>"></div>
    <div><label for="lim-ag-<%= e.id %>">Limite agrégat ($)</label>
      <input type="number" id="lim-ag-<%= e.id %>" name="limite_agregat" min="0" step="0.01" value="<%= g && g.limite_agregat !== null ? g.limite_agregat : '' %>"></div>
    <div><label for="fr-<%= e.id %>">Franchise ($)</label>
      <input type="number" id="fr-<%= e.id %>" name="franchise" min="0" step="0.01" value="<%= g && g.franchise !== null ? g.franchise : '' %>"></div>
    <div><label for="prime-<%= e.id %>">Prime ($, si connue)</label>
      <input type="number" id="prime-<%= e.id %>" name="prime" min="0" step="0.01" value="<%= g && g.prime !== null ? g.prime : '' %>"></div>
    <% const CHAMPS_RC2 = [['prejudice_personnel_publicite', 'Préjudice personnel et préjudice découlant de la publicité ($)'], ['frais_medicaux_par_personne', 'Frais médicaux — par personne ($)'], ['frais_medicaux_par_sinistre', 'Frais médicaux — par sinistre ($)'], ['responsabilite_locative', 'Responsabilité locative — ce lieu ($)'], ['rc_auto_non_proprietaires', 'RC automobiles non-propriétaires ($)'], ['produits_travaux_termines_montant', 'Produits et travaux terminés ($)'], ['pollution_montant', 'Pollution / atteinte à l’environnement ($)'], ['umbrella_montant', 'Umbrella — montant ($)'], ['umbrella_retention', 'Umbrella — rétention ($)']]; %>
    <% CHAMPS_RC2.forEach(([champ, libelle]) => { %>
    <div><label for="<%= champ %>-<%= e.id %>"><%= libelle %></label>
      <input type="number" id="<%= champ %>-<%= e.id %>" name="<%= champ %>" min="0" step="0.01" value="<%= g && g[champ] != null ? g[champ] : '' %>"></div>
    <% }) %>
    <div><label for="uagr-<%= e.id %>">Umbrella — type d’agrégat</label>
      <input type="text" id="uagr-<%= e.id %>" name="umbrella_agregat_type" value="<%= g && g.umbrella_agregat_type ? g.umbrella_agregat_type : '' %>" placeholder="Ex. par emplacement / global"></div>
    <div style="grid-column:1/-1">
      <span class="petit">Umbrella — polices sous-jacentes (type, assureur, nº de police, limite $, expiration)</span>
      <div data-lignes-dynamiques data-existant='<%= g && g.umbrella_sous_jacentes ? JSON.stringify(g.umbrella_sous_jacentes).replace(/'/g, "&#39;") : "[]" %>'>
        <div class="lignes"></div>
        <template><div class="ligne-dynamique" style="display:flex;gap:8px;margin:6px 0">
          <input data-col="type" type="text" placeholder="Type (RC, auto…)" maxlength="60">
          <input data-col="assureur" type="text" placeholder="Assureur" maxlength="120">
          <input data-col="numero_police" type="text" placeholder="Nº de police" maxlength="60">
          <input data-col="limite" type="number" min="0" placeholder="Limite $" style="width:130px">
          <input data-col="date_expiration" type="date" aria-label="Expiration">
          <button type="button" class="btn btn-petit btn-secondaire retirer-ligne">✕</button>
        </div></template>
        <button type="button" class="btn btn-petit btn-secondaire ajouter-ligne">+ Ajouter une police sous-jacente</button>
        <input type="hidden" name="umbrella_sous_jacentes_json" value="[]">
      </div>
    </div>
    <div style="grid-column:1/-1"><span class="petit">Avenants</span><br>
      <% AVENANTS_RC.forEach(([code, libelle], i) => { %>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="av-<%= e.id %>-<%= i %>" name="avenants" value="<%= code %>"<%= g && g.avenants && g.avenants[code] ? ' checked' : '' %>><label for="av-<%= e.id %>-<%= i %>"><%= libelle %></label></span>
      <% }) %></div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les garanties</button></div>
  </form>
  <% }) %>
</div>

<div class="carte" id="antecedents">
  <h2>📋 Antécédents d’assurance</h2>
  <% const a = s.antecedents; %>
  <form method="post" action="/rc/<%= s.id %>/antecedents" class="grille-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="ass-actuel">Assureur actuel</label>
      <input type="text" id="ass-actuel" name="assureur_actuel" maxlength="120" value="<%= a && a.assureur_actuel ? a.assureur_actuel : '' %>"></div>
    <div><label for="pol-actuelle">N° de police actuelle</label>
      <input type="text" id="pol-actuelle" name="numero_police_actuelle" maxlength="60" value="<%= a && a.numero_police_actuelle ? a.numero_police_actuelle : '' %>"></div>
    <div><label for="exp-actuelle">Expiration</label>
      <input type="date" id="exp-actuelle" name="date_expiration_actuelle" value="<%= a && a.date_expiration_actuelle ? a.date_expiration_actuelle : '' %>"></div>
    <div><label for="annees-cont">Années d’assurance continue</label>
      <input type="number" id="annees-cont" name="annees_assurance_continue" min="0" max="80" value="<%= a && a.annees_assurance_continue !== null && a.annees_assurance_continue !== undefined ? a.annees_assurance_continue : '' %>"></div>
    <div style="grid-column:1/-1">
      <span class="petit">Sinistres des 5 dernières années (date, type, montant $)</span>
      <div data-lignes-dynamiques data-existant='<%= a && a.sinistres_5ans ? JSON.stringify(a.sinistres_5ans).replace(/'/g, "&#39;") : "[]" %>'>
        <div class="lignes"></div>
        <template><div class="ligne-dynamique" style="display:flex;gap:8px;margin:6px 0">
          <input data-col="date" type="date" aria-label="Date">
          <input data-col="type" type="text" placeholder="Type" maxlength="120">
          <input data-col="montant" type="number" min="0" step="0.01" placeholder="Montant $" style="width:120px">
          <button type="button" class="btn btn-petit btn-secondaire retirer-ligne">✕</button>
        </div></template>
        <button type="button" class="btn btn-petit btn-secondaire ajouter-ligne">+ Ajouter un sinistre</button>
        <input type="hidden" name="sinistres_json" value="[]">
      </div>
    </div>
    <div style="grid-column:1/-1"><span class="petit">Consentements</span><br>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="cons-credit" name="consentement_credit"<%= a && a.consentements && a.consentements.credit ? ' checked' : '' %>><label for="cons-credit">Dossier de crédit</label></span>
      <span class="case" style="display:inline-flex;margin-right:12px"><input type="checkbox" id="cons-ass" name="consentement_dossier_assurance"<%= a && a.consentements && a.consentements.dossier_assurance ? ' checked' : '' %>><label for="cons-ass">Dossier d’assurance (sinistres antérieurs)</label></span>
    </div>
    <div class="actions" style="grid-column:1/-1"><button class="btn btn-petit btn-secondaire" type="submit">Enregistrer les antécédents</button></div>
  </form>
</div>

<div class="carte" id="versions">
  <h2>🕘 Historique des versions</h2>
  <p class="petit">Chaque enregistrement fige une version : rien n’est jamais modifié ni effacé.</p>
  <div class="tableau-deroulant"><table>
    <thead><tr><th>Version</th><th>Statut</th><th>Créée le</th><th>Par</th><th></th></tr></thead>
    <tbody>
    <% versions.forEach((v) => { %>
      <tr>
        <td><strong>v<%= v.version %></strong></td>
        <td><%= NOMS_STATUTS_SOUMISSION[v.statut] || v.statut %></td>
        <td><%= (v.cree_le || '').slice(0, 16).replace('T', ' ') %></td>
        <td><%= v.auteur || '—' %></td>
        <td><a class="btn btn-petit btn-secondaire" href="/rc/<%= s.id %>/versions/<%= v.version %>">Voir</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/bas') %>
