<%- include('../partials/haut', { titre: 'Révision — ouverture de dossier' }) %>
<div class="entete-page"><h1>🎙️ Ouverture de dossier — révision</h1></div>

<% if (dejaInsere) { %>
<div class="carte">
  <p>✅ Cette dictée a déjà servi à ouvrir un dossier :
    <% if (a.soumission_id && a.produit_insere) { %>soumission <a href="/<%= a.produit_insere %>/<%= a.soumission_id %>">#<%= a.soumission_id %></a> (<%= NOMS_PRODUITS[a.produit_insere] || a.produit_insere %>)<% } %>
  </p>
  <p class="petit">Pour un autre dossier, repassez par « 🎙️ Ouvrir un dossier » et dictez une nouvelle note.</p>
</div>
<% } else { %>

<div class="carte">
  <h3>📝 Note dictée</h3>
  <pre style="white-space:pre-wrap;max-height:220px;overflow:auto;"><%= a.texte_extrait || '' %></pre>
  <% if (a.message) { %><p class="alerte">ℹ️ <%= a.message %></p><% } %>
  <p class="petit">Corrigez chaque bloc au besoin. <strong>Rien n'est créé tant que vous n'avez pas cliqué
    sur « ✅ Créer le dossier »</strong>, en bas de page.</p>
</div>

<form method="post" action="/ouverture/<%= a.id %>/creer">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="google_place_id" id="google_place_id" value="">

  <div class="carte">
    <h3>🏢 Entreprise</h3>
    <% if (existantes.length) { %>
      <div class="alerte">
        <p>⚠️ <strong>Entreprise existante probable</strong> — choisissez quoi faire :</p>
        <label style="display:block;margin:6px 0;">
          <input type="radio" name="mode_entreprise" value="nouveau">
          Créer quand même une nouvelle entreprise (doublon possible)
        </label>
        <% existantes.forEach(function (e) { %>
          <label style="display:block;margin:6px 0;">
            <input type="radio" name="mode_entreprise" value="existant:<%= e.id %>" <%= e.exact ? 'checked' : '' %>>
            Utiliser l'entreprise existante : <a href="/clients/<%= e.id %>" target="_blank"><%= e.raison_sociale %></a>
            (<%= e.ville || 'ville inconnue' %>)<%= e.source === 'google' ? ' — repérée par Google Maps (même établissement)' : '' %>
          </label>
        <% }); %>
        <p class="petit">Si vous utilisez l'entreprise existante, ses coordonnées ne sont pas modifiées :
          seule la soumission y est ouverte (et son identifiant Google posé s'il manquait).</p>
      </div>
    <% } else { %>
      <input type="hidden" name="mode_entreprise" value="nouveau">
    <% } %>
    <div class="grille-form">
      <div><label for="ent_raison_sociale">Raison sociale *</label><input type="text" id="ent_raison_sociale" name="ent_raison_sociale" value="<%= entreprise.raison_sociale || '' %>"></div>
      <div><label for="ent_neq">NEQ (10 chiffres)</label><input type="text" id="ent_neq" name="ent_neq" maxlength="10" value="<%= entreprise.neq || '' %>"></div>
      <div><label for="ent_adresse">Adresse</label><input type="text" id="ent_adresse" name="ent_adresse" value="<%= entreprise.adresse || '' %>"></div>
      <div><label for="ent_ville">Ville</label><input type="text" id="ent_ville" name="ent_ville" value="<%= entreprise.ville || '' %>"></div>
      <div><label for="ent_province">Province</label><input type="text" id="ent_province" name="ent_province" value="<%= entreprise.province || '' %>" placeholder="QC"></div>
      <div><label for="ent_code_postal">Code postal</label><input type="text" id="ent_code_postal" name="ent_code_postal" value="<%= entreprise.code_postal || '' %>"></div>
      <div><label for="ent_telephone_entreprise">Téléphone de l'entreprise</label><input type="tel" id="ent_telephone_entreprise" name="ent_telephone_entreprise" value="<%= entreprise.telephone_entreprise || '' %>"></div>
      <div><label for="ent_courriel_entreprise">Courriel de l'entreprise</label><input type="email" id="ent_courriel_entreprise" name="ent_courriel_entreprise" value="<%= entreprise.courriel_entreprise || '' %>"></div>
      <div><label for="ent_site_web">Site web</label><input type="text" id="ent_site_web" name="ent_site_web" value="<%= entreprise.site_web || '' %>"></div>
    </div>
  </div>

  <div class="carte">
    <h3>🗺️ Trouvé sur Google Maps</h3>
    <% if (googleStatut === 'non_configure') { %>
      <p class="petit">Clé Google Maps non configurée — l'ouverture fonctionne sans l'enrichissement.
        Un administrateur peut ajouter la clé dans Admin → Clé IA (Cohere), section « 🗺️ Clé Google Maps (Places) ».</p>
    <% } else if (googleStatut === 'erreur') { %>
      <p class="petit">⚠️ Recherche Google Maps impossible pour le moment<%= googleMessage ? ' : ' + googleMessage : '' %>.
        Vous pouvez poursuivre avec les informations dictées.</p>
    <% } else if (!candidats.length) { %>
      <p class="petit">Aucune entreprise trouvée sur Google Maps pour ce nom. Vous pouvez poursuivre avec les informations dictées.</p>
    <% } else { %>
      <p class="petit">Cliquez sur un candidat pour remplir l'entreprise (adresse complète, code postal,
        téléphone, site web). Vous pourrez encore corriger avant de créer.</p>
      <% candidats.forEach(function (cand, i) { %>
        <div class="candidat-google" style="border:1px solid #ccc;border-radius:8px;padding:10px;margin:8px 0;">
          <label style="display:block;cursor:pointer;">
            <input type="radio" name="candidat_google" value="<%= i %>" data-candidat="<%= encodeURIComponent(JSON.stringify(cand)) %>">
            <strong><%= cand.raison_sociale || 'Sans nom' %></strong>
            <% if (cand.note != null) { %> · ★ <%= cand.note %> (<%= cand.nb_avis || 0 %> avis)<% } %>
            <% if (cand.statut_affaires === 'OPERATIONAL') { %> · <span class="badge badge-ok">En affaires</span>
            <% } else if (cand.statut_affaires === 'CLOSED_TEMPORARILY') { %> · <span class="badge">Fermé temporairement</span>
            <% } else if (cand.statut_affaires === 'CLOSED_PERMANENTLY') { %> · <span class="badge">Fermé définitivement</span><% } %>
            <br>
            <span class="petit"><%= cand.adresse_complete || '' %><% if (cand.telephone) { %> · <%= cand.telephone %><% } %><% if (cand.site_web) { %> · <%= cand.site_web %><% } %></span>
          </label>
          <% if (cand.clientExistantId) { %>
            <p class="alerte" style="margin-top:8px;">⚠️ <strong>Ce dossier existe déjà</strong> :
              <a href="/clients/<%= cand.clientExistantId %>" target="_blank">voir l'entreprise au dossier</a> —
              choisissez « Utiliser l'entreprise existante » ci-dessus pour ouvrir la soumission chez elle.</p>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="carte">
    <h3>👤 Contact</h3>
    <div class="grille-form">
      <div><label for="contact_prenom">Prénom</label><input type="text" id="contact_prenom" name="contact_prenom" value="<%= contact.prenom || '' %>"></div>
      <div><label for="contact_nom">Nom</label><input type="text" id="contact_nom" name="contact_nom" value="<%= contact.nom || '' %>"></div>
      <div><label for="contact_titre">Titre / fonction</label><input type="text" id="contact_titre" name="contact_titre" value="<%= contact.titre || '' %>"></div>
      <div><label for="contact_courriel">Courriel du contact</label><input type="email" id="contact_courriel" name="contact_courriel" value="<%= contact.courriel || '' %>"></div>
      <div><label for="contact_telephone">Téléphone du contact</label><input type="tel" id="contact_telephone" name="contact_telephone" value="<%= contact.telephone || '' %>"></div>
    </div>
    <p class="petit">Le contact est créé (ou mis à jour comme contact principal) seulement si vous créez une
      nouvelle entreprise. Pour une entreprise existante, ses contacts ne sont pas touchés.</p>
  </div>

  <div class="carte">
    <h3>📋 Soumission à ouvrir</h3>
    <label for="produit">Produit *</label>
    <select id="produit" name="produit" required>
      <option value="">— Choisir le produit —</option>
      <% Object.entries(NOMS_PRODUITS).forEach(function ([code, nom]) { %>
        <option value="<%= code %>" <%= a.produit_detecte === code ? 'selected' : '' %>><%= nom %></option>
      <% }); %>
    </select>
    <% if (soumissionChamps.length) { %>
    <h4>Champs dictés pour la soumission</h4>
    <table class="tableau">
      <thead><tr><th>Inclure</th><th>Champ</th><th>Valeur (modifiable)</th><th>Confiance</th><th>Extrait source</th></tr></thead>
      <tbody>
      <% soumissionChamps.forEach(function (c) { %>
        <tr>
          <td><input type="checkbox" name="inclure_<%= c.index %>" <%= c.confiance !== 'basse' ? 'checked' : '' %>></td>
          <td><%= c.libelle %> <span class="petit">(<%= c.table %>.<%= c.colonne %>)</span></td>
          <td><input type="text" name="valeur_<%= c.index %>" value="<%= c.valeur %>" style="width:100%;"></td>
          <td><%= c.confiance %></td>
          <td class="petit"><%= c.extrait || '—' %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <% } %>
    <% Object.entries(a.listes || {}).forEach(function ([type, items]) { %>
      <% const metaL = META_LISTES[type]; if (!metaL || !items.length) return; %>
      <% const colsL = Object.entries(metaL.champs).filter(function ([cle, cm]) { return !cm.produits || !a.produit_detecte || cm.produits.includes(a.produit_detecte); }); %>
      <h4>📋 <%= metaL.libelle %> (<%= items.length %>) — éléments dictés</h4>
      <p class="petit">Chaque ligne cochée sera versée dans la soumission créée. Corrigez les cellules au besoin.
        Un bâtiment ou un lieu sans adresse hérite de l'adresse de l'entreprise.</p>
      <table class="tableau">
        <thead><tr><th>Inclure</th><% colsL.forEach(function ([cle, cm]) { %><th><%= cm.libelle %></th><% }); %><th>Confiance</th></tr></thead>
        <tbody id="corps-liste-<%= type %>" data-prochain-index="<%= items.length %>">
        <% items.forEach(function (item, i) { %>
          <tr>
            <td><input type="checkbox" name="liste_<%= type %>_<%= i %>_inclure" <%= item.confiance !== 'basse' ? 'checked' : '' %>></td>
            <% colsL.forEach(function ([cle, cm]) { %>
              <td>
              <% if (type === 'batiments' && cle === 'gicleurs') { %>
                <select name="liste_<%= type %>_<%= i %>_<%= cle %>">
                  <option value="">—</option>
                  <option value="1" <%= item.champs[cle] === 1 || item.champs[cle] === '1' || item.champs[cle] === true ? 'selected' : '' %>>Oui</option>
                  <option value="0" <%= item.champs[cle] === 0 || item.champs[cle] === '0' || item.champs[cle] === false ? 'selected' : '' %>>Non</option>
                </select>
              <% } else { %>
                <input type="text" name="liste_<%= type %>_<%= i %>_<%= cle %>" value="<%= item.champs[cle] != null ? item.champs[cle] : '' %>" style="width:100%;">
              <% } %>
              </td>
            <% }); %>
            <td><%= item.confiance %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
      <template id="modele-ligne-<%= type %>">
        <tr>
          <td><input type="checkbox" name="liste_<%= type %>___N___inclure" checked></td>
          <% colsL.forEach(function ([cle, cm]) { %>
            <td><input type="text" name="liste_<%= type %>___N___<%= cle %>" value="" style="width:100%;"></td>
          <% }); %>
          <td>manuelle</td>
        </tr>
      </template>
      <button type="button" class="btn btn-petit btn-secondaire" data-ajouter-ligne="<%= type %>">＋ Ajouter une ligne</button>
    <% }); %>
    <div style="margin-top:16px;">
      <button type="submit" class="btn">✅ Créer le dossier</button>
      <span class="petit">L'entreprise (ou l'existante choisie), le contact et la soumission sont créés d'un coup ;
        vous arrivez ensuite sur la fiche de la soumission, avec ses informations manquantes.</span>
    </div>
  </div>
</form>
<script src="/analyse-revision.js" defer></script>
<script src="/ouverture.js" defer></script>
<% } %>
<%- include('../partials/bas') %>
