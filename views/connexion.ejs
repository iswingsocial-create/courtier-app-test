<%- include('partials/haut', { titre: 'Connexion', etroit: true }) %>
<div class="carte">
  <h2>🛡️ Connexion</h2>
  <p class="petit">Outil de gestion pour cabinet de courtage — vos données restent au Québec.</p>
  <% if (erreur) { %><div class="alerte alerte-erreur"><%= erreur %></div><% } %>
  <form method="post" action="/connexion">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="retour" value="<%= retour %>">
    <label for="email">Courriel</label>
    <input type="email" id="email" name="email" required autocomplete="username">
    <label for="mdp">Mot de passe</label>
    <input type="password" id="mdp" name="mot_de_passe" required autocomplete="current-password">
    <div class="actions"><button class="btn" type="submit">Se connecter</button></div>
  </form>
</div>
<%- include('partials/bas') %>
